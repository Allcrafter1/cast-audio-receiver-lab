+    fn coalesce_pending_selection(&self, incoming: Incoming) -> Incoming {
+        if let Incoming::Command(LoungeCommand::SetPlaylist {
+            ref video_ids, current_index, current_time, ref list_id,
+        }) = incoming {
+            if self.awaiting_load
+                && self.video_id.is_some()
+                && self.video_id.as_ref() == video_ids.get(current_index)
+                && self.current_index == current_index
+                && self.state.as_ref().is_some_and(|s| s.current_time == current_time)
+            {
+                tracing::info!("coalesced pending YouTube selection into queue update");
+                return Incoming::Command(LoungeCommand::UpdatePlaylist {
+                    video_ids: video_ids.clone(), list_id: list_id.clone(),
+                });
+            }
+        }
+        incoming
+    }
