+#[tokio::test]
+async fn validates_native_context_and_timing_before_any_request() {
+    let session = TuneInSession {
+        tune_url: "http://invalid.invalid".into(),
+        feed_url: "http://invalid.invalid".into(),
+        timeout: Duration::from_secs(1),
+    };
+    for data in [
+        json!({"guideId":null}),
+        json!({"guideId":123}),
+        json!({"guideId":""}),
+        json!({"guideId":"s12/../other"}),
+        json!({"guideId":"t123"}),
+        json!({"guideId":"s123","serial":"bad\nserial"}),
+        json!({"guideId":"s123","accessToken":"bad\r\nsecret"}),
+        json!({"guideId":"s123","version":{"invalid":"value"}}),
+        json!({"guideId":"s123","version":false}),
+    ] {
+        let mut request = load();
+        request.custom_data = Some(data);
+        let error = session
+            .resolve_media(&context(), &request)
+            .await
+            .unwrap_err();
+        assert_eq!(error.code, MediaResolveCode::InvalidRequest);
+    }
+    for time in [-1.0, 1.0, f64::NAN, f64::INFINITY] {
+        let mut request = load();
+        request.current_time = time;
+        assert_eq!(
+            session
+                .resolve_media(&context(), &request)
+                .await
+                .unwrap_err()
+                .code,
+            MediaResolveCode::InvalidRequest
+        );
+    }
+    let mut request = load();
+    request.media.duration = Some(f64::NAN);
+    assert_eq!(
+        session
+            .resolve_media(&context(), &request)
+            .await
+            .unwrap_err()
+            .code,
+        MediaResolveCode::InvalidRequest
+    );
+    // Placing native context inside media.customData is not the CAF protocol.
+    request = load();
+    request.media.custom_data = request.custom_data.take();
+    assert_eq!(
+        session
+            .resolve_media(&context(), &request)
+            .await
+            .unwrap_err()
+            .code,
+        MediaResolveCode::InvalidRequest
+    );
+}
