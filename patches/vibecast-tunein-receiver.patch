+#[tokio::test]
+async fn maps_http_and_tune_api_errors_without_exposing_response_data() {
+    for (http_status, body, code) in [
+        (
+            401,
+            json!({"private":"sensitive-value"}),
+            MediaResolveCode::AuthRequired,
+        ),
+        (403, json!({}), MediaResolveCode::AccessDenied),
+        (429, json!({}), MediaResolveCode::UpstreamFailure),
+        (
+            200,
+            json!({"head":{"status":"404","fault":"sensitive-value"},"body":[]}),
+            MediaResolveCode::ContentUnavailable,
+        ),
+    ] {
+        let (session, server) = fixture(|_| {
+            vec![Reply {
+                status: http_status,
+                body: serde_json::to_vec(&body).unwrap(),
+            }]
+        })
+        .await;
+        let error = session
+            .resolve_media(&context(), &load())
+            .await
+            .unwrap_err();
+        assert_eq!(error.code, code);
+        assert!(!error.to_string().contains("sensitive-value"));
+        assert!(!error.to_string().contains("test-token"));
+        server.await.unwrap();
+    }
+}
