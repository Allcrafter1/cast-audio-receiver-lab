+use super::*;
+use std::collections::HashMap;
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use tokio::net::{TcpListener, TcpStream};
+use tokio::task::JoinHandle;
+use vibecast_sdk::{NoopSenderChannel, ReceiverContext};
+
+struct Reply {
+    status: u16,
+    body: Vec<u8>,
+}
+
+impl Reply {
+    fn json(value: Value) -> Self {
+        Self {
+            status: 200,
+            body: serde_json::to_vec(&value).unwrap(),
+        }
+    }
+}
+
+async fn read_request(socket: &mut TcpStream) -> String {
+    let mut request = Vec::new();
+    loop {
+        let mut byte = [0];
+        socket.read_exact(&mut byte).await.unwrap();
+        request.push(byte[0]);
+        if request.ends_with(b"\r\n\r\n") {
+            return String::from_utf8(request).unwrap();
+        }
+        assert!(request.len() < 32 * 1024);
+    }
+}
+
+async fn fixture(
+    make: impl FnOnce(&str) -> Vec<Reply>,
+) -> (TuneInSession, JoinHandle<Vec<String>>) {
+    let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let base = format!("http://{}", listener.local_addr().unwrap());
+    let replies = make(&base);
+    let server = tokio::spawn(async move {
+        let mut requests = Vec::new();
+        for reply in replies {
+            let (mut socket, _) = listener.accept().await.unwrap();
+            requests.push(read_request(&mut socket).await);
+            let header = format!("HTTP/1.1 {} Response\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n", reply.status, reply.body.len());
+            socket.write_all(header.as_bytes()).await.unwrap();
+            let _ = socket.write_all(&reply.body).await;
+        }
+        requests
+    });
+    (
+        TuneInSession {
+            tune_url: format!("{base}/Tune.ashx"),
+            feed_url: base,
+            timeout: Duration::from_secs(1),
+        },
+        server,
+    )
+}
+
+fn context() -> AppContext {
+    AppContext::new(
+        "session",
+        "transport",
+        "12F05308",
+        reqwest::Client::new(),
+        ReceiverContext::new("Radio", "Model", "private-device", Default::default()),
+        Arc::new(NoopSenderChannel),
+    )
+}
+
+fn load() -> LoadRequest {
+    serde_json::from_value(json!({
+        "requestId": 1,
+        "media": {"contentId": "tunein-radio", "contentType": "", "streamType": "BUFFERED"},
+        "customData": {"guideId": "s123", "serial": "test-serial", "partnerId": "test-partner", "version": 1.6201, "accessToken": "test-token"}
+    })).unwrap()
+}
+
+fn station(source: &str) -> Value {
+    json!({"head": {"status": "200"}, "body": [{"element": "audio", "url": source,
+        "media_type": "mp3", "guide_id": "e456", "is_direct": true}]})
+}
+
+fn request_url(request: &str) -> Url {
+    Url::parse(&format!(
+        "http://fixture{}",
+        request.split_whitespace().nth(1).unwrap()
+    ))
+    .unwrap()
+}
+
+#[test]
+fn advertises_the_native_tunein_app() {
+    assert_eq!(TuneIn.manifest().app_ids, &["12F05308"]);
+    assert!(TuneIn.manifest().namespaces.is_empty());
+}
