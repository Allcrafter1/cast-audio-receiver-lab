+//! TuneIn's CAF media LOAD protocol for live radio.
+//!
+//! The sender provides its station and request context in top-level customData.
+//! Station lookup is confined to TuneIn's APIs; credentials never accompany
+//! requests to station streams or TuneIn's stream-wrapper URLs.
+
+#![forbid(unsafe_code)]
+
+use std::sync::Arc;
+use std::time::{Duration, SystemTime, UNIX_EPOCH};
+
+use async_trait::async_trait;
+use serde::{Deserialize, Deserializer};
+use serde_json::{json, Value};
+use url::Url;
+use vibecast_sdk::{
+    normalize_stream_type, AppContext, AppManifest, AppProvider, AppSession, LaunchCredentials,
+    LaunchError, LoadRequest, MediaImage, MediaMetadata, MediaResolveCode, MediaResolveError,
+    PlaybackMedia, PlaybackStream, StreamSource, StreamType,
+};
+
+const TUNE_URL: &str = "https://opml.tunein.com/Tune.ashx";
+const FEED_URL: &str = "https://feed.tunein.com";
+const API_TIMEOUT: Duration = Duration::from_secs(5);
+const MAX_JSON_BYTES: usize = 512 * 1024;
+const MAX_STREAMS: usize = 32;
+const MAX_WRAPPER_REQUESTS: usize = 3;
+
+/// TuneIn live-radio application, using the sender's normal Cast media channel.
+#[derive(Debug, Default)]
+pub struct TuneIn;
+
+#[async_trait]
+impl AppProvider for TuneIn {
+    fn manifest(&self) -> AppManifest {
+        AppManifest::without_settings("tunein", &["12F05308"], "TuneIn")
+    }
+
+    async fn launch(
+        &self,
+        _ctx: &AppContext,
+        _credentials: LaunchCredentials,
+    ) -> Result<Arc<dyn AppSession>, LaunchError> {
+        Ok(Arc::new(TuneInSession {
+            tune_url: TUNE_URL.into(),
+            feed_url: FEED_URL.into(),
+            timeout: API_TIMEOUT,
+        }))
+    }
+}
+
+struct TuneInSession {
+    tune_url: String,
+    feed_url: String,
+    timeout: Duration,
+}
+
+// Deliberately does not implement Debug: accessToken and serial stay private.
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct TuneRequest {
+    guide_id: String,
+    serial: Option<String>,
+    partner_id: Option<String>,
+    #[serde(default, deserialize_with = "deserialize_version")]
+    version: Option<String>,
+    access_token: Option<String>,
+}
+
+fn deserialize_version<'de, D: Deserializer<'de>>(
+    deserializer: D,
+) -> Result<Option<String>, D::Error> {
+    match Option::<Value>::deserialize(deserializer)? {
+        None => Ok(None),
+        Some(Value::String(value)) => Ok(Some(value)),
+        Some(Value::Number(value)) => Ok(Some(value.to_string())),
+        _ => Err(serde::de::Error::custom("invalid version")),
+    }
+}
+
+impl TuneRequest {
+    fn parse(data: &Value) -> Result<Self, MediaResolveError> {
+        let request: Self = serde_json::from_value(data.clone())
+            .map_err(|_| MediaResolveError::invalid_request("INVALID_TUNEIN_REQUEST"))?;
+        if request.guide_id.len() > 32
+            || !request.guide_id.starts_with('s')
+            || request.guide_id.len() < 2
+            || !request.guide_id[1..].bytes().all(|c| c.is_ascii_digit())
+        {
+            return Err(MediaResolveError::invalid_request("UNSUPPORTED_GUIDE_ID"));
+        }
+        for value in [&request.serial, &request.partner_id, &request.version]
+            .into_iter()
+            .flatten()
+        {
+            if value.len() > 512 || value.chars().any(char::is_control) {
+                return Err(MediaResolveError::invalid_request("INVALID_TUNEIN_CONTEXT"));
+            }
+        }
+        if request.access_token.as_ref().is_some_and(|value| {
+            value.len() > 16 * 1024 || value.bytes().any(|c| !c.is_ascii_graphic())
+        }) {
+            return Err(MediaResolveError::invalid_request("INVALID_TUNEIN_CONTEXT"));
+        }
+        Ok(request)
+    }
+
+    fn query(&self) -> Vec<(&str, &str)> {
+        let mut query = vec![
+            ("formats", "mp3,aac,ogg,wav,hls"),
+            (
+                "partnerId",
+                self.partner_id
+                    .as_deref()
+                    .filter(|v| !v.is_empty())
+                    .unwrap_or("qZjjnm85"),
+            ),
+            ("itemUrlScheme", "secure"),
+            ("mode", "chromecast"),
+            ("render", "json"),
+        ];
+        if let Some(serial) = &self.serial {
+            query.push(("serial", serial));
+        }
+        if let Some(version) = &self.version {
+            query.push(("version", version));
+        }
+        query
+    }
+}
+
+#[async_trait]
+impl AppSession for TuneInSession {
+    async fn resolve_media(
+        &self,
+        ctx: &AppContext,
+        request: &LoadRequest,
+    ) -> Result<PlaybackMedia, MediaResolveError> {
+        validate_time(request)?;
+        let Some(data) = request
+            .custom_data
+            .as_ref()
+            .filter(|v| v.get("guideId").is_some())
+        else {
+            return resolve_direct(&ctx.session_id, request);
+        };
+        let tune = TuneRequest::parse(data)?;
+        if request.current_time > 0.0 {
+            return Err(MediaResolveError::invalid_request("LIVE_SEEK_UNSUPPORTED"));
+        }
+        let listen_id = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .unwrap_or_default()
+            .as_secs()
+            .to_string();
+        let mut query = tune.query();
+        query.extend([
+            ("id", tune.guide_id.as_str()),
+            ("listenId", listen_id.as_str()),
+        ]);
+        let response = self
+            .api_json(ctx, &self.tune_url, &query, tune.access_token.as_deref())
+            .await?;
+        check_tune_status(&response)?;
+        let candidates = response
+            .get("body")
+            .and_then(Value::as_array)
+            .ok_or_else(|| upstream("INVALID_TUNEIN_RESPONSE"))?;
+        if candidates.len() > MAX_STREAMS {
+            return Err(upstream("TOO_MANY_TUNEIN_STREAMS"));
+        }
+        // Prerolls require a sequential ad/content player. Do not silently turn
+        // an ad into the whole radio station or drop it from the sequence.
+        if candidates.iter().any(|item| flag(item.get("is_preroll"))) {
+            return Err(MediaResolveError::content_unavailable(
+                "TUNEIN_PREROLL_UNSUPPORTED",
+            ));
+        }
+        let mut streams = Vec::new();
+        let mut wrapper_requests = 0;
+        for candidate in candidates {
+            if candidate.get("element").and_then(Value::as_str) != Some("audio") {
+                continue;
+            }
+            let Some(source) = candidate
+                .get("url")
+                .and_then(Value::as_str)
+                .filter(|v| valid_url(v))
+            else {
+                continue;
+            };
+            if flag(candidate.get("is_proxy")) {
+                if wrapper_requests == MAX_WRAPPER_REQUESTS {
+                    return Err(upstream("TOO_MANY_TUNEIN_WRAPPERS"));
+                }
+                wrapper_requests += 1;
+                let wrapper = self
+                    .api_json(ctx, source, &[("render", "json")], None)
+                    .await?;
+                let unwrapped = wrapper
+                    .get("Streams")
+                    .and_then(Value::as_array)
+                    .ok_or_else(|| upstream("INVALID_TUNEIN_WRAPPER"))?;
+                if unwrapped.len() > MAX_STREAMS {
+                    return Err(upstream("TOO_MANY_TUNEIN_STREAMS"));
+                }
+                for item in unwrapped {
+                    if let Some(stream) = stream(item, "Url", "MediaType") {
+                        streams.push(stream);
+                    }
+                }
+            } else if let Some(stream) = stream(candidate, "url", "media_type") {
+                streams.push(stream);
+            }
+            // The bridge selects the first stream. Avoid extra wrapper requests
+            // for alternate bitrates once a playable candidate is available.
+            if !streams.is_empty() {
+                break;
+            }
+        }
+        if streams.is_empty() {
+            return Err(MediaResolveError::content_unavailable("NO_TUNEIN_STREAMS"));
+        }
+        let metadata_url = format!("{}/profiles/{}/nowPlaying", self.feed_url, tune.guide_id);
+        let now_playing = self
+            .api_json(
+                ctx,
+                &metadata_url,
+                &tune.query(),
+                tune.access_token.as_deref(),
+            )
+            .await
+            .unwrap_or(Value::Null);
+        if flag(now_playing.pointer("/Classification/IsOnDemand")) {
+            return Err(MediaResolveError::content_unavailable(
+                "TUNEIN_ON_DEMAND_UNSUPPORTED",
+            ));
+        }
+        let metadata = radio_metadata(&now_playing, request.media.metadata.as_ref());
+        let mut media = PlaybackMedia::new(&ctx.session_id, streams, StreamType::Live);
+        media.content_id = media.streams[0].source.as_url().map(str::to_owned);
+        media.title = metadata.title.clone();
+        media.subtitle = metadata.subtitle.clone();
+        media.images = metadata.images.clone();
+        media.metadata = Some(metadata);
+        media.autoplay = request.autoplay;
+        media.custom_data = Some(json!({"guideId": tune.guide_id, "contentId": tune.guide_id}));
+        Ok(media)
+    }
+}
+
+impl TuneInSession {
+    async fn api_json(
+        &self,
+        ctx: &AppContext,
+        source: &str,
+        query: &[(&str, &str)],
+        token: Option<&str>,
+    ) -> Result<Value, MediaResolveError> {
+        let mut request = ctx.http.get(source).query(query).timeout(self.timeout);
+        if let Some(token) = token.filter(|v| !v.is_empty()) {
+            request = request.bearer_auth(token);
+        }
+        let mut response = request
+            .send()
+            .await
+            .map_err(|_| upstream("TUNEIN_HTTP_ERROR"))?;
+        if !response.status().is_success() {
+            return Err(MediaResolveError::from_http_status(
+                response.status().as_u16(),
+                Some("TUNEIN_HTTP_STATUS".into()),
+            ));
+        }
+        if response
+            .content_length()
+            .is_some_and(|len| len > MAX_JSON_BYTES as u64)
+        {
+            return Err(upstream("TUNEIN_RESPONSE_TOO_LARGE"));
+        }
+        let mut bytes = Vec::new();
+        while let Some(chunk) = response
+            .chunk()
+            .await
+            .map_err(|_| upstream("TUNEIN_HTTP_ERROR"))?
+        {
+            if chunk.len() > MAX_JSON_BYTES.saturating_sub(bytes.len()) {
+                return Err(upstream("TUNEIN_RESPONSE_TOO_LARGE"));
+            }
+            bytes.extend_from_slice(&chunk);
+        }
+        serde_json::from_slice(&bytes).map_err(|_| upstream("INVALID_TUNEIN_JSON"))
+    }
+}
+
+fn upstream(detail: &'static str) -> MediaResolveError {
+    MediaResolveError::new(MediaResolveCode::UpstreamFailure, detail)
+}
+
+fn check_tune_status(response: &Value) -> Result<(), MediaResolveError> {
+    let status = response.pointer("/head/status");
+    let status = status.and_then(|v| v.as_u64().or_else(|| v.as_str()?.parse().ok()));
+    match status {
+        Some(200) => Ok(()),
+        Some(code @ 400..=599) => Err(MediaResolveError::from_http_status(
+            code as u16,
+            Some("TUNEIN_API_STATUS".into()),
+        )),
+        _ => Err(upstream("INVALID_TUNEIN_RESPONSE")),
+    }
+}
+
+fn flag(value: Option<&Value>) -> bool {
+    value.is_some_and(|v| v == true || v.as_str().is_some_and(|v| v.eq_ignore_ascii_case("true")))
+}
+
+fn valid_url(source: &str) -> bool {
+    !source.chars().any(char::is_control)
+        && Url::parse(source).is_ok_and(|url| {
+            matches!(url.scheme(), "http" | "https")
+                && url.host_str().is_some()
+                && url.username().is_empty()
+                && url.password().is_none()
+        })
+}
+
+fn stream(value: &Value, url_key: &str, format_key: &str) -> Option<PlaybackStream> {
+    let source = value.get(url_key)?.as_str().filter(|v| valid_url(v))?;
+    let format = value
+        .get(format_key)
+        .and_then(Value::as_str)
+        .unwrap_or("mp3")
+        .to_ascii_lowercase();
+    let mime = if source.to_ascii_lowercase().contains(".m3u8") {
+        "application/x-mpegURL"
+    } else {
+        match format.as_str() {
+            "mp3" => "audio/mpeg",
+            "aac" => "audio/mp4",
+            "ogg" => "audio/ogg",
+            "wav" => "audio/vnd.wav",
+            "hls" => "application/x-mpegURL",
+            _ => return None,
+        }
+    };
+    Some(PlaybackStream {
+        source: StreamSource::Url(source.into()),
+        content_type: mime.into(),
+        drm: None,
+    })
+}
+
+fn radio_metadata(value: &Value, fallback: Option<&MediaMetadata>) -> MediaMetadata {
+    let text = |path| {
+        value
+            .pointer(path)
+            .and_then(Value::as_str)
+            .filter(|v| !v.is_empty())
+            .map(str::to_owned)
+    };
+    let station = text("/Header/Title");
+    let mut metadata = fallback.cloned().unwrap_or_default();
+    metadata.metadata_type = 3;
+    metadata.title = text("/Header/Subtitle")
+        .or_else(|| station.clone())
+        .or(metadata.title);
+    metadata.subtitle = station.clone().or(metadata.subtitle);
+    metadata.artist = station.or(metadata.artist);
+    if let Some(image) = text("/Secondary/Image")
+        .or_else(|| text("/Primary/Image"))
+        .filter(|v| valid_url(v))
+    {
+        metadata.images = vec![MediaImage {
+            url: image,
+            height: None,
+            width: None,
+        }];
+    }
+    metadata
+}
+
+fn validate_time(request: &LoadRequest) -> Result<(), MediaResolveError> {
+    if !request.current_time.is_finite()
+        || request.current_time < 0.0
+        || request
+            .media
+            .duration
+            .is_some_and(|v| !v.is_finite() || v < 0.0)
+    {
+        return Err(MediaResolveError::invalid_request("INVALID_MEDIA_TIME"));
+    }
+    Ok(())
+}
+
+fn resolve_direct(
+    session_id: &str,
+    request: &LoadRequest,
+) -> Result<PlaybackMedia, MediaResolveError> {
+    let info = &request.media;
+    let source = info.content_url.as_deref().unwrap_or(&info.content_id);
+    if !valid_url(source) {
+        return Err(MediaResolveError::invalid_request("INVALID_MEDIA_URL"));
+    }
+    if info.content_type.trim().is_empty() || info.content_type.chars().any(char::is_control) {
+        return Err(MediaResolveError::invalid_request("INVALID_CONTENT_TYPE"));
+    }
+    let stream_type = if info.is_live_media == Some(true) {
+        StreamType::Live
+    } else {
+        normalize_stream_type(info.stream_type)
+    };
+    if stream_type == StreamType::Live && request.current_time > 0.0 {
+        return Err(MediaResolveError::invalid_request("LIVE_SEEK_UNSUPPORTED"));
+    }
+    let mut media = PlaybackMedia::new(
+        session_id,
+        vec![PlaybackStream {
+            source: StreamSource::Url(source.into()),
+            content_type: info.content_type.clone(),
+            drm: None,
+        }],
+        stream_type,
+    );
+    media.content_id = Some(info.content_id.clone());
+    media.metadata = info.metadata.clone();
+    media.title = info.metadata.as_ref().and_then(|v| v.title.clone());
+    media.subtitle = info.metadata.as_ref().and_then(|v| v.subtitle.clone());
+    media.images = info
+        .metadata
+        .as_ref()
+        .map(|v| v.images.clone())
+        .unwrap_or_default();
+    media.duration = info.duration;
+    media.autoplay = request.autoplay;
+    media.start_time = request.current_time;
+    media.custom_data = info.custom_data.clone();
+    Ok(media)
+}
