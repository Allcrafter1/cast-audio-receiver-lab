+#[tokio::test]
+async fn direct_url_load_preserves_signatures_metadata_and_explicit_playback_intent() {
+    let source = "https://radio.example/a%2fb?signature=a%2Bb&x=1";
+    let session = TuneInSession {
+        tune_url: "unused".into(),
+        feed_url: "unused".into(),
+        timeout: API_TIMEOUT,
+    };
+    let mut request = load();
+    request.custom_data = None;
+    request.media.content_id = "logical-id".into();
+    request.media.content_url = Some(source.into());
+    request.media.content_type = "audio/mpeg".into();
+    request.media.metadata = Some(serde_json::from_value(json!({"metadataType":3,"title":"Track","artist":"Artist","images":[{"url":"https://radio.example/logo.png"}]})).unwrap());
+    request.autoplay = false;
+    request.current_time = 12.5;
+    request.media.duration = Some(40.0);
+    let media = session.resolve_media(&context(), &request).await.unwrap();
+    assert_eq!(media.streams[0].source.as_url(), Some(source));
+    assert_eq!(media.content_id.as_deref(), Some("logical-id"));
+    assert_eq!(media.metadata, request.media.metadata);
+    assert_eq!(media.start_time, 12.5);
+    assert_eq!(media.duration, Some(40.0));
+    assert!(!media.autoplay);
+    assert_eq!(media.stream_type, StreamType::Buffered);
+    request.media.is_live_media = Some(true);
+    assert!(session.resolve_media(&context(), &request).await.is_err());
+    request.current_time = 0.0;
+    assert_eq!(
+        session
+            .resolve_media(&context(), &request)
+            .await
+            .unwrap()
+            .stream_type,
+        StreamType::Live
+    );
+    for source in [
+        "file:///private",
+        "pipe:0",
+        "https://user:secret@radio.example/live",
+        "https://radio.example/live\n",
+    ] {
+        request.media.content_url = Some(source.into());
+        assert!(session.resolve_media(&context(), &request).await.is_err());
+    }
+    request.media.content_url = Some("https://radio.example/live".into());
+    request.media.content_type = "audio/mpeg\r\nheader: value".into();
+    assert!(session.resolve_media(&context(), &request).await.is_err());
+}
