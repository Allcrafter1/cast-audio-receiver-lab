+#[tokio::test]
+async fn native_load_uses_top_level_context_and_pascal_case_station_metadata() {
+    let source = "https://radio.example/live%2fa?signature=a%2Bb&x=1";
+    let (session, server) = fixture(|_| {
+        vec![
+            Reply::json(station(source)),
+            Reply::json(json!({
+                "Header": {"Title": "Station", "Subtitle": "Current programme"},
+                "Primary": {"GuideId": "s123", "Image": "https://radio.example/logo.png"},
+                "Classification": {"IsOnDemand": false}, "Token": "metadata-must-not-be-echoed"
+            })),
+        ]
+    })
+    .await;
+    let mut request = load();
+    request.autoplay = false;
+    // A sender's stale URL must not override its selected TuneIn station.
+    request.media.content_url = Some("https://stale.example/old.mp3".into());
+    let media = session.resolve_media(&context(), &request).await.unwrap();
+    assert_eq!(media.streams[0].source.as_url(), Some(source));
+    assert_eq!(media.stream_type, StreamType::Live);
+    assert_eq!(media.title.as_deref(), Some("Current programme"));
+    assert_eq!(media.subtitle.as_deref(), Some("Station"));
+    assert_eq!(
+        media.metadata.as_ref().unwrap().artist.as_deref(),
+        Some("Station")
+    );
+    assert_eq!(media.images[0].url, "https://radio.example/logo.png");
+    assert_eq!(media.duration, None);
+    assert_eq!(media.start_time, 0.0);
+    assert!(!media.autoplay);
+    assert_eq!(
+        media.custom_data,
+        Some(json!({"guideId":"s123","contentId":"s123"}))
+    );
+    let requests = server.await.unwrap();
+    assert_eq!(requests.len(), 2);
+    let tune_url = request_url(&requests[0]);
+    assert_eq!(tune_url.path(), "/Tune.ashx");
+    let query: HashMap<_, _> = tune_url.query_pairs().collect();
+    for (key, expected) in [
+        ("id", "s123"),
+        ("serial", "test-serial"),
+        ("partnerId", "test-partner"),
+        ("version", "1.6201"),
+        ("render", "json"),
+        ("mode", "chromecast"),
+        ("formats", "mp3,aac,ogg,wav,hls"),
+        ("itemUrlScheme", "secure"),
+    ] {
+        assert_eq!(query.get(key).map(|v| v.as_ref()), Some(expected));
+    }
+    assert!(query["listenId"].parse::<u64>().unwrap() > 0);
+    assert_eq!(
+        request_url(&requests[1]).path(),
+        "/profiles/s123/nowPlaying"
+    );
+    for request in requests {
+        assert!(request
+            .to_ascii_lowercase()
+            .contains("authorization: bearer test-token\r\n"));
+        assert!(!request.lines().next().unwrap().contains("test-token"));
+    }
+}
