+#[tokio::test]
+async fn stalled_optional_metadata_does_not_fail_resolved_audio() {
+    let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let address = listener.local_addr().unwrap();
+    let server = tokio::spawn(async move {
+        let (mut tune_socket, _) = listener.accept().await.unwrap();
+        read_request(&mut tune_socket).await;
+        let body = serde_json::to_vec(&station("https://radio.example/live")).unwrap();
+        let header = format!(
+            "HTTP/1.1 200 OK\r\nContent-Length: {}\r\nConnection: close\r\n\r\n",
+            body.len()
+        );
+        tune_socket.write_all(header.as_bytes()).await.unwrap();
+        tune_socket.write_all(&body).await.unwrap();
+        let (_metadata_socket, _) = listener.accept().await.unwrap();
+        tokio::time::sleep(Duration::from_millis(100)).await;
+    });
+    let session = TuneInSession {
+        tune_url: format!("http://{address}/Tune.ashx"),
+        feed_url: format!("http://{address}"),
+        timeout: Duration::from_millis(25),
+    };
+    let media = session.resolve_media(&context(), &load()).await.unwrap();
+    assert_eq!(
+        media.streams[0].source.as_url(),
+        Some("https://radio.example/live")
