+    /// Returns the service type including the domain label.
+    ///
+    /// For example: "_my-service._udp.local.".
+    #[inline]
+    pub fn get_type(&self) -> &str {
+        &self.ty_domain
+    }
+
+    /// Returns the service subtype including the domain label,
+    /// if subtype has been defined.
+    ///
+    /// For example: "_printer._sub._http._tcp.local.".
+    #[inline]
+    pub const fn get_subtype(&self) -> &Option<String> {
+        &self.sub_domain
+    }
+
+    /// Adds subtype PTRs pointing to this same service instance.
+    ///
+    /// Each subtype must be a fully qualified name for this service type, for
+    /// example `_printer._sub._http._tcp.local.`. Duplicate names are ignored
+    /// case-insensitively. This never creates a second service registration or
+    /// changes the service instance, host, port, or TXT record.
+    ///
+    /// The subtype passed to [`ServiceInfo::new`], if any, remains the first
+    /// subtype returned by [`ServiceInfo::get_subtype`]. Otherwise the first
+    /// added subtype is returned by that legacy accessor.
+    pub fn with_subtypes<I, S>(mut self, subtypes: I) -> Result<Self>
+    where
+        I: IntoIterator<Item = S>,
+        S: AsRef<str>,
+    {
+        for subtype in subtypes {
+            let subtype = subtype.as_ref();
+            let suffix = format!("._sub.{}", self.ty_domain);
+            let label_len = subtype.len().saturating_sub(suffix.len());
+            if label_len == 0
+                || !subtype
+                    .get(label_len..)
+                    .is_some_and(|tail| tail.eq_ignore_ascii_case(&suffix))
+            {
+                return Err(Error::Msg(format!(
+                    "subtype {subtype:?} must belong to service type {:?}",
+                    self.ty_domain
+                )));
+            }
+            let label = &subtype[..label_len];
+            if label.len() > 63
+                || label
+                    .bytes()
+                    .any(|b| b == b'.' || b == b'\\' || b.is_ascii_control())
+            {
+                return Err(Error::Msg(format!(
+                    "subtype {subtype:?} must contain one nonempty label of at most 63 bytes"
+                )));
+            }
+            if self
+                .get_subtypes()
+                .any(|known| known.eq_ignore_ascii_case(subtype))
+            {
+                continue;
+            }
+            let subtype = format!("{label}{suffix}");
+            if self.sub_domain.is_none() {
+                self.sub_domain = Some(subtype);
+            } else {
+                self.additional_sub_domains.push(subtype);
+            }
+        }
+        Ok(self)
+    }
+
+    /// Returns every advertised subtype, including the legacy first subtype.
+    pub fn get_subtypes(&self) -> impl Iterator<Item = &str> {
+        self.sub_domain
+            .iter()
+            .chain(self.additional_sub_domains.iter())
+            .map(String::as_str)
+    }
+
+    /// Returns whether the service type or subtype matches the given name.
+    pub(crate) fn matches_type_or_subtype(&self, name: &str) -> bool {
+        (self.advertise_base_type && name.eq_ignore_ascii_case(self.get_type()))
+            || self
+                .get_subtypes()
+                .any(|subtype| name.eq_ignore_ascii_case(subtype))
+    }
+
