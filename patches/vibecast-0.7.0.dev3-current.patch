+        assert_eq!(info["deviceId"], id);
+        assert_eq!(info["deviceCapabilities"], caps);
+        send(client, ns::RECEIVER, "receiver-0", r#"{"type":"GET_APP_AVAILABILITY","requestId":7002,"appId":["APP1","CC1AD845","UNKNOWN"]}"#).await;
+        let availability = next_json_for_request(client, 7002).await;
+        assert_eq!(availability["availability"][available], "APP_AVAILABLE");
+        assert_eq!(availability["availability"][unavailable], "APP_UNAVAILABLE");
+        assert_eq!(availability["availability"]["UNKNOWN"], "APP_UNAVAILABLE");
+    }
+    let first = launch_for_continuity(&mut speaker, "sender-1", "APP1", 7010).await;
+    send(
+        &mut speaker,
+        ns::RECEIVER,
+        "receiver-0",
+        r#"{"type":"SET_VOLUME","requestId":7011,"volume":{"level":0.37,"muted":true}}"#,
+    )
+    .await;
+    next_json_for_request(&mut speaker, 7011).await;
