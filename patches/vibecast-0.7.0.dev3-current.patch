+    let drain = tokio::spawn(async move {
+        while let Some(event) = event_rx.recv().await {
+            if let WorkerEvent::ResolutionFailed { acknowledged, .. } = event {
+                let _ = acknowledged.send(());
+            }
+        }
+    });
+    run_commands_with_events(
+        commands,
+        resolver,
+        playback,
+        capabilities,
+        settings,
+        event_tx,
+        cancel,
+    )
+    .await;
+    drain.abort();
+}
