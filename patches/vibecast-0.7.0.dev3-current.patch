+        match event {
+            ServiceEvent::ServiceResolved(info) => {
+                resolved = true;
+                println!("Resolved a service of {}", &info.get_fullname());
+                break;
+            }
+            other => {
+                println!("Received event {:?}", other);
+            }
+        }
+    }
