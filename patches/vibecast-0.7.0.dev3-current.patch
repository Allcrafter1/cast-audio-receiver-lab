+    .await;
+    drop(speaker);
+    send(
+        &mut video,
+        ns::RECEIVER,
+        "receiver-0",
+        r#"{"type":"GET_STATUS","requestId":7022}"#,
+    )
+    .await;
+    let status = next_json_for_request(&mut video, 7022).await;
+    assert_eq!(
+        status["status"]["applications"].as_array().unwrap().len(),
+        1
+    );
+    assert_eq!(status["status"]["applications"][0]["transportId"], second);
+    let mut speaker = connect_endpoint(
+        &h.hub,
+        4,
+        "12345678-1234-5678-9abc-123456789abc",
+        199428,
+        crate::AppVisibility::Except(vec!["CC1AD845".into()]),
+    )
+    .await;
+    let third = launch_for_continuity(&mut speaker, "sender-1", "APP1", 7030).await;
+    assert_ne!(second, third);
+    send(
+        &mut video,
+        ns::RECEIVER,
+        "receiver-0",
+        r#"{"type":"GET_STATUS","requestId":7031}"#,
+    )
+    .await;
+    let status = next_json_for_request(&mut video, 7031).await;
+    assert_eq!(
+        status["status"]["applications"].as_array().unwrap().len(),
+        1
+    );
+    assert_eq!(status["status"]["applications"][0]["transportId"], third);
+    let dirs = h.launched_data_dirs.lock().unwrap().clone();
+    assert_eq!(dirs.len(), 3);
+    assert_eq!(
+        *h.launched_names.lock().unwrap(),
+        vec!["Shared output", "Shared output (YT)", "Shared output"]
+    );
+    assert!(
+        dirs.iter().all(|dir| dir == &dirs[0]),
+        "aliases share canonical app storage"
+    );
+    h.hub.shutdown().await;
