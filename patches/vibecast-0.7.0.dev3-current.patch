+/// At most one unsent snapshot of each feedback kind. Playback transitions are
+/// applied to CurrentMedia before entering this queue; HTTP never gates them.
+#[derive(Default)]
+struct PendingFeedback(std::collections::VecDeque<Outbound>);
+
+impl PendingFeedback {
+    fn push(&mut self, outbound: Outbound) {
+        if let Some(existing) = self
+            .0
+            .iter_mut()
+            .find(|existing| std::mem::discriminant(*existing) == std::mem::discriminant(&outbound))
+        {
+            *existing = outbound;
+        } else {
+            self.0.push_back(outbound);
+        }
+    }
+
+    fn pop(&mut self) -> Option<Outbound> {
+        self.0.pop_front()
+    }
+
+    fn clear_state(&mut self) {
+        self.0
+            .retain(|outbound| !matches!(outbound, Outbound::State(_)));
+    }
 }
 
