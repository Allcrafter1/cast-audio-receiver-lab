+async fn send_post(request: reqwest::RequestBuilder) -> Result<(), LoungeError> {
+    let started = std::time::Instant::now();
+    let failure = |stage: &'static str, error: reqwest::Error| {
+        tracing::warn!(
+            stage,
+            elapsed_ms = started.elapsed().as_millis() as u64,
+            timeout = error.is_timeout(),
+            status = error.status().map(|status| status.as_u16()),
+            "YouTube Lounge feedback failed"
+        );
+        LoungeError::Http(error)
+    };
+    request
+        .send()
+        .await
+        .map_err(|error| failure("headers", error))?
+        .error_for_status()
+        .map_err(|error| failure("status", error))?
+        .bytes()
+        .await
+        .map_err(|error| failure("body", error))?;
+    tracing::debug!(
+        elapsed_ms = started.elapsed().as_millis() as u64,
+        "YouTube Lounge feedback completed"
+    );
+    Ok(())
 }
 
