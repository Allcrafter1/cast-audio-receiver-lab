+        199428,
+        crate::AppVisibility::Except(vec!["CC1AD845".into()]),
+    )
+    .await;
+    let mut video = connect_endpoint(
+        &h.hub,
+        3,
+        "23456789-2345-6789-abcd-23456789abcd",
+        199429,
+        crate::AppVisibility::Only(vec!["CC1AD845".into()]),
+    )
+    .await;
+    for (client, id, caps, available, unavailable) in [
+        (
+            &mut speaker,
+            "12345678123456789abc123456789abc",
+            199428,
+            "APP1",
+            "CC1AD845",
+        ),
+        (
+            &mut video,
+            "2345678923456789abcd23456789abcd",
+            199429,
+            "CC1AD845",
+            "APP1",
+        ),
+    ] {
+        send(
+            client,
+            ns::DISCOVERY,
+            "receiver-0",
+            r#"{"type":"GET_DEVICE_INFO","requestId":7001}"#,
