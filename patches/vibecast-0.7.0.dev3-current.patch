+    send(
+        client,
+        ns::CONNECTION,
+        "receiver-0",
+        r#"{"type":"CONNECT"}"#,
+    )
+    .await;
+    send(
+        client,
+        ns::RECEIVER,
+        "receiver-0",
+        r#"{"type":"GET_APP_AVAILABILITY","requestId":4,"appId":["APP1","CC1AD845","UNREGISTERED"]}"#,
+    )
+    .await;
+    let reply = next_json(client).await;
+    assert_eq!(reply["type"], "GET_APP_AVAILABILITY");
+    assert_eq!(reply["requestId"], 4);
+    assert_eq!(reply["availability"].as_object().unwrap().len(), 3);
+    assert_eq!(reply["availability"]["APP1"], "APP_AVAILABLE");
+    assert_eq!(reply["availability"]["CC1AD845"], "APP_AVAILABLE");
+    assert_eq!(reply["availability"]["UNREGISTERED"], "APP_UNAVAILABLE");
+    assert!(harness.player.commands().is_empty());
+
+    send(
+        client,
+        ns::RECEIVER,
+        "receiver-0",
+        r#"{"type":"LAUNCH","requestId":5,"appId":"UNREGISTERED"}"#,
+    )
+    .await;
+    let rejected = next_json(client).await;
+    assert_eq!(rejected["type"], "LAUNCH_ERROR");
+    assert_eq!(rejected["requestId"], 5);
+    assert!(harness.player.commands().is_empty());
+
+    // An unsupported launch must leave the advertised supported app usable.
+    let transport = launch(client).await;
+    assert!(!transport.is_empty());
+    harness.hub.shutdown().await;
+}
