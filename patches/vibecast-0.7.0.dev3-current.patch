+        let task = tokio::spawn(async move {
+            connection
+                .run_bound(
+                    &command_tx,
+                    &mut playback_rx,
+                    &mut control_rx,
+                    &mut cancel_rx,
+                )
+                .await
+        });
+        let volume_replies = || async {
+            server
+                .received_requests()
+                .await
+                .unwrap()
+                .into_iter()
+                .filter(|request| {
