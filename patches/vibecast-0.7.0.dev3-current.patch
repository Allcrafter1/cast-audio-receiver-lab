+        .and_then(parse_navigation_item);
+    let next = set
+        .pointer("/nextVideoRenderer/autoplayEndpointRenderer/endpoint")
+        .and_then(parse_navigation_item)
+        .or_else(|| {
+            set.pointer("/autoplayVideoRenderer/mdxAutoplayVideoRenderer/navigationEndpoint")
+                .and_then(parse_navigation_item)
+        });
+    NavigationNeighbors { previous, next }
