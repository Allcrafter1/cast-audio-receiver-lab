+        id,
+        Arc::from(format!("endpoint-{id}")),
+        Arc::new(dummy_auth()),
+        events_tx,
+    ));
+    let hub = hub.clone();
+    tokio::spawn(async move {
+        while let Some(event) = events_rx.recv().await {
+            if hub
+                .send_endpoint_event(event, profile.clone())
+                .await
+                .is_err()
+            {
+                break;
+            }
+        }
+    });
+    Framed::new(client_end, CastCodec)
+}
