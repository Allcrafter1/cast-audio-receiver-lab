+    assert_eq!(status["status"][0]["currentTime"], 0.0);
+    send(
+        &mut h.client,
+        ns::MEDIA,
+        &transport,
+        r#"{"type":"LOAD","requestId":4,"media":{"contentId":"fast"}}"#,
+    )
+    .await;
+    for _ in 0..3 {
+        next_json(&mut h.client).await;
