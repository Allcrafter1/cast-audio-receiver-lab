+++ b/crates/vibecast-apps-youtube/src/volume.rs
@@ -0,0 +1,211 @@
+//! Optional inverse of YouTube Music Web's slider curve, not an output gain law.
+
+use std::sync::Mutex;
+
+use serde_json::Value;
+use vibecast_sdk::{AppSettingsReader, SettingKey};
+
+pub(crate) const WEB_VOLUME_COMPATIBILITY: SettingKey<bool> =
+    SettingKey::new("web_volume_compatibility");
+
+pub(crate) struct WebVolumeCompatibility {
+    settings: AppSettingsReader,
+    // A retired Lounge poll must not classify a replacement controller.
+    profile: Mutex<(u64, bool)>,
+}
+
+impl WebVolumeCompatibility {
+    pub(crate) fn new(settings: AppSettingsReader) -> Self {
+        Self {
+            settings,
+            profile: Mutex::new((0, false)),
+        }
+    }
+
+    pub(crate) fn reset(&self) {
+        let mut profile = self.profile.lock().unwrap();
+        *profile = (profile.0.wrapping_add(1), false);
+    }
+
+    pub(crate) fn epoch(&self) -> u64 {
+        self.profile.lock().unwrap().0
+    }
+
+    pub(crate) fn music_web_at_epoch(&self, epoch: u64) -> bool {
+        let profile = self.profile.lock().unwrap();
+        profile.0 == epoch && profile.1
+    }
+
+    pub(crate) fn observe(&self, epoch: u64, music_web: bool) -> bool {
+        let mut profile = self.profile.lock().unwrap();
+        if profile.0 != epoch || profile.1 == music_web {
+            return false;
+        }
+        profile.1 = music_web;
+        tracing::info!(
+            music_web_controller = music_web,
+            "YouTube web volume controller profile changed"
+        );
+        true
+    }
+
+    fn active(&self, browser: bool) -> bool {
+        browser
+            && self.profile.lock().unwrap().1
+            && self
+                .settings
+                .snapshot()
+                .get(WEB_VOLUME_COMPATIBILITY)
+                .ok()
+                .flatten()
+                .unwrap_or(true)
+    }
+
+    pub(crate) fn decode_sender(&self, level: f64, browser: bool) -> f64 {
+        if !self.active(browser) || !level.is_finite() {
+            return level;
+        }
+        // Preserve exact endpoints. Do not round here: the web sender already
+        // quantizes its wire value and output precision should not add jitter.
+        if level <= 0.0 {
+            return 0.0;
+        }
+        if level >= 1.0 {
+            return 1.0;
+        }
+        // Exact inverse of the forward curve avoids drift from the website's
+        // rounded inverse coefficients during repeated status round trips.
+        (((level * 100.0 + 7.13431).log2() - 2.82823) / (0.03917 * 100.0)).clamp(0.0, 1.0)
+    }
+
+    pub(crate) fn to_sender(&self, level: f64, browser: bool) -> f64 {
+        if !self.active(browser) || !level.is_finite() {
+            return level;
+        }
+        if level <= 0.0 {
+            return 0.0;
+        }
+        if level >= 1.0 {
+            return 1.0;
+        }
+        ((2_f64.powf(0.03917 * level * 100.0 + 2.82823) - 7.13431) / 100.0).clamp(0.0, 1.0)
+    }
+}
+
+/// Lounge identifies the application, whereas Cast identifies its transport.
+/// No profile for mobile, regular YouTube, unknown or multiple controllers.
+pub(crate) fn music_web_controller(params: Option<&Value>) -> bool {
+    let Some(devices) = params
+        .and_then(|p| p.get("devices"))
+        .and_then(Value::as_str)
+        .and_then(|raw| serde_json::from_str::<Value>(raw).ok())
+    else {
+        return false;
+    };
+    let Some(devices) = devices.as_array().filter(|devices| devices.len() <= 32) else {
+        return false;
+    };
+    let mut controller = None;
+    for device in devices {
+        match device.get("type").and_then(Value::as_str) {
+            Some("LOUNGE_SCREEN") => continue,
+            Some("REMOTE_CONTROL") => {}
+            _ => return false,
+        }
+        if controller.is_some() {
+            return false;
+        }
+        controller = Some(device);
+    }
+    controller.is_some_and(|device| {
+        device.get("app").and_then(Value::as_str) == Some("youtube.m-desktop")
+            && device
+                .get("id")
+                .and_then(Value::as_str)
+                .is_some_and(|id| !id.trim().is_empty() && id.len() <= 256)
+            && device
+                .get("theme")
+                .is_none_or(|theme| theme.as_str() == Some("m"))
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    fn profile() -> WebVolumeCompatibility {
+        WebVolumeCompatibility::new(crate::tests::test_settings())
+    }
+
+    fn snapshot(devices: Value) -> Value {
+        json!({"devices": devices.to_string()})
+    }
+
+    #[test]
+    fn only_one_identified_music_web_controller_is_eligible() {
+        let web = json!({"id":"web","type":"REMOTE_CONTROL",
+            "app":"youtube.m-desktop","theme":"m"});
+        assert!(music_web_controller(Some(&snapshot(json!([web])))));
+        assert!(music_web_controller(Some(&snapshot(json!([
+            {"type":"LOUNGE_SCREEN","id":"screen"}, web
+        ])))));
+        for devices in [
+            json!([]),
+            json!([{"id":"yt","type":"REMOTE_CONTROL","app":"youtube-desktop"}]),
+            json!([{"id":"phone","type":"REMOTE_CONTROL","app":"youtube.m-android"}]),
+            json!([{"id":"unknown","type":"REMOTE_CONTROL","theme":"m"}]),
+            json!([web, {"id":"phone","type":"REMOTE_CONTROL"}]),
+            json!([web, web]),
+            json!([web, {"id":"unknown"}]),
+            json!([{"id":"web","type":"REMOTE_CONTROL","app":"youtube.m-desktop","theme":"u"}]),
+            json!([{"type":"REMOTE_CONTROL","app":"youtube.m-desktop"}]),
+        ] {
+            assert!(
+                !music_web_controller(Some(&snapshot(devices.clone()))),
+                "{devices}"
+            );
+        }
+        assert!(!music_web_controller(None));
+        assert!(!music_web_controller(Some(&json!({"devices":"not json"}))));
+        assert!(!music_web_controller(Some(&snapshot(json!({})))));
+    }
+
+    #[test]
+    fn browser_gate_and_takeover_preserve_identity_without_fresh_evidence() {
+        let profile = profile();
+        assert_eq!(profile.decode_sender(0.2, true), 0.2);
+        assert_eq!(profile.to_sender(0.5, true), 0.5);
+        let old_epoch = profile.epoch();
+        assert!(profile.observe(old_epoch, true));
+        assert_eq!(profile.decode_sender(0.2, false), 0.2);
+        assert_eq!(profile.to_sender(0.5, false), 0.5);
+        assert!((profile.decode_sender(0.2, true) - 0.4937).abs() < 0.001);
+        profile.reset();
+        assert!(!profile.observe(old_epoch, true));
+        assert_eq!(profile.decode_sender(0.2, true), 0.2);
+        assert!(profile.observe(profile.epoch(), true));
+        assert!(profile.observe(profile.epoch(), false));
+        assert_eq!(profile.to_sender(0.5, true), 0.5);
+    }
+
+    #[test]
+    fn volume_projection_roundtrips_and_preserves_exact_mute_endpoints() {
+        let profile = profile();
+        profile.observe(profile.epoch(), true);
+        for level in [0.0, 1.0] {
+            assert_eq!(profile.decode_sender(level, true), level);
+            assert_eq!(profile.to_sender(level, true), level);
+        }
+        let mut last = 0.0;
+        for percent in 1..100 {
+            let canonical = percent as f64 / 100.0;
+            let wire = profile.to_sender(canonical, true);
+            assert!(wire > last);
+            last = wire;
+            assert!((profile.decode_sender(wire, true) - canonical).abs() < 0.0001);
+        }
+        assert!((profile.to_sender(0.5, true) - 0.204682).abs() < 0.00001);
+        assert!(profile.decode_sender(f64::NAN, true).is_nan());
+    }
+}
