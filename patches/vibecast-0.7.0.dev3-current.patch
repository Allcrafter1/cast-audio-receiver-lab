+        playback_tx
+            .send(PlaybackState {
+                player_state: PlayerState::Paused,
+                current_time: 42.0,
+                duration: Some(100.0),
+                idle_reason: None,
+                media_recovery_attempts: 0,
+            })
+            .await
+            .unwrap();
+        tokio::time::timeout(Duration::from_millis(150), async {
+            loop {
+                if server
+                    .received_requests()
+                    .await
+                    .unwrap()
+                    .iter()
+                    .any(|request| {
+                        let body = String::from_utf8_lossy(&request.body);
+                        body.contains("req0__sc=onStateChange")
+                            && body.contains("req0_currentTime=42")
+                    })
+                {
+                    break;
+                }
+                tokio::task::yield_now().await;
+            }
+        })
+        .await
+        .expect("volume debounce delayed playback feedback");
