+                    ("webm", true) => "video/webm",
+                    ("m4a" | "mp4", false) => "audio/mp4",
+                    ("webm", false) => "audio/webm",
+                    ("opus" | "ogg", _) => "audio/ogg",
+                    ("mp3", _) => "audio/mpeg",
+                    _ => "application/octet-stream",
+                })
+                .map(str::to_owned)
