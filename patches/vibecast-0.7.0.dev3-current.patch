+async fn connect_peer(
+    hub: &DeviceHubHandle,
+    id: u64,
+    peer: &str,
+) -> Framed<DuplexStream, CastCodec> {
+    let (server_end, client_end) = tokio::io::duplex(64 * 1024);
+    let (events_tx, mut events_rx) = mpsc::channel::<ServerEvent>(32);
+    tokio::spawn(run_connection(
+        server_end,
+        id,
+        Arc::from(peer.to_owned()),
+        Arc::new(dummy_auth()),
+        events_tx,
+    ));
+    let hub = hub.clone();
+    tokio::spawn(async move {
+        while let Some(event) = events_rx.recv().await {
+            if hub.send_server_event(event).await.is_err() {
+                break;
+            }
+        }
+    });
+    Framed::new(client_end, CastCodec)
+}
+
+async fn connect_endpoint(
+    hub: &DeviceHubHandle,
+    id: u64,
+    device_id: &str,
+    capabilities: i64,
+    apps: crate::AppVisibility,
+) -> Framed<DuplexStream, CastCodec> {
+    let profile = crate::EndpointProfile {
+        identity: DeviceIdentity::new(
+            if capabilities == 199429 {
+                "Shared output (YT)"
+            } else {
+                "Shared output"
+            }
+            .into(),
+            "Audio Speaker".into(),
+            device_id.into(),
+        ),
+        capabilities,
+        discovery_apps: apps.clone(),
+        launch_apps: apps,
+    };
+    connect_profile(hub, id, profile).await
+}
+
+async fn connect_profile(
+    hub: &DeviceHubHandle,
+    id: u64,
+    profile: crate::EndpointProfile,
+) -> Framed<DuplexStream, CastCodec> {
+    let profile = Arc::new(profile);
+    let (server_end, client_end) = tokio::io::duplex(64 * 1024);
+    let (events_tx, mut events_rx) = mpsc::channel(32);
