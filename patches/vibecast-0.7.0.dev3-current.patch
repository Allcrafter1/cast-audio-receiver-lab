+    #[test]
+    fn multi_subtype_announcement_and_goodbye_share_one_instance_and_cache_all_ptrs() {
+        let (service, intf) = multi_subtype_fixture();
+        let mut registry = crate::service_info::DnsRegistry::new();
+        let out = super::prepare_announce(&service, &intf, &mut registry, true).unwrap();
+        let incoming = multi_subtype_wire(&out);
+        let ptrs: Vec<_> = incoming
+            .answers()
+            .iter()
+            .filter_map(|r| r.any().downcast_ref::<DnsPointer>())
+            .collect();
+        assert_eq!(ptrs.len(), 3);
+        for (ptr, expected) in
+            ptrs.iter()
+                .zip([MULTI_SUBTYPE_BASE, MULTI_SUBTYPE_A, MULTI_SUBTYPE_B])
+        {
+            assert_eq!(ptr.get_name(), expected);
+            assert_eq!(ptr.alias(), service.get_fullname());
+            assert!(!ptr.get_cache_flush(), "PTR records are shared");
+        }
+        for rr_type in [RRType::SRV, RRType::TXT, RRType::A] {
+            assert_eq!(
+                incoming
+                    .answers()
+                    .iter()
+                    .filter(|r| r.get_type() == rr_type)
+                    .count(),
+                1
+            );
+        }
+        let mut cache = crate::dns_cache::DnsCache::new();
+        let mut timers = Vec::new();
+        for record in incoming.all_records() {
+            cache
+                .add_or_update(&intf, record, &mut timers, true)
+                .unwrap();
+        }
+        for name in [MULTI_SUBTYPE_BASE, MULTI_SUBTYPE_A, MULTI_SUBTYPE_B] {
+            let records = cache.get_ptr(name).unwrap();
+            assert_eq!(records.len(), 1);
+            let ptr = records[0]
+                .record
+                .any()
+                .downcast_ref::<DnsPointer>()
+                .unwrap();
+            assert_eq!(ptr.alias(), service.get_fullname());
+        }
+
+        let mut goodbye = DnsOutgoing::new(FLAGS_QR_RESPONSE | FLAGS_AA);
+        super::add_service_ptrs(&mut goodbye, &service, service.get_fullname(), 0);
+        assert!(goodbye
+            ._answers()
+            .iter()
+            .all(|(record, _)| record.get_record().get_ttl() == 0));
+        let goodbye = multi_subtype_wire(&goodbye);
+        assert_eq!(goodbye.answers().len(), 3);
+        for record in goodbye.answers() {
+            // The wire decoder gives TTL-zero goodbyes the RFC 6762 one-second
+            // grace period before removing their cached records.
+            assert_eq!(record.get_record().get_ttl(), 1);
+            assert_eq!(
+                record.any().downcast_ref::<DnsPointer>().unwrap().alias(),
+                service.get_fullname()
+            );
+        }
+    }
