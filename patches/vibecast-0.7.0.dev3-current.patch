+    // A cached, wrong endpoint must reject LAUNCH before stopping playback or
+    // preparing a new output volume.
+    send(
+        &mut video,
+        ns::RECEIVER,
+        "receiver-0",
+        r#"{"type":"LAUNCH","requestId":7012,"appId":"APP1"}"#,
+    )
