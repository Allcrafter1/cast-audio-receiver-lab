+        vec![
+            Reply::json(station("https://radio.example/live")),
+            Reply::json(json!({"Classification":{"IsOnDemand":true}})),
+        ]
+    })
+    .await;
+    let mut request = load();
+    request.custom_data.as_mut().unwrap()["version"] = json!("1.6201");
+    let error = session
+        .resolve_media(&context(), &request)
+        .await
+        .unwrap_err();
+    assert_eq!(
+        error.detail_code.as_deref(),
+        Some("TUNEIN_ON_DEMAND_UNSUPPORTED")
+    );
+    let requests = server.await.unwrap();
+    let url = request_url(&requests[0]);
+    assert!(url
+        .query_pairs()
+        .any(|(key, value)| key == "version" && value == "1.6201"));
+}
+
+#[tokio::test]
+async fn all_declared_audio_formats_and_manifest_override_reach_the_player() {
+    for (format, path, expected) in [
+        ("mp3", "live", "audio/mpeg"),
+        ("aac", "live", "audio/mp4"),
+        ("ogg", "live", "audio/ogg"),
+        ("wav", "live", "audio/vnd.wav"),
+        ("hls", "manifest", "application/x-mpegURL"),
+        ("mp3", "live.m3u8?signature=a%2Bb", "application/x-mpegURL"),
+    ] {
+        let source = format!("https://radio.example/{path}");
+        let (session, server) = fixture(|_| {
+            let mut response = station(&source);
+            response["body"][0]["media_type"] = json!(format);
+            vec![Reply::json(response), Reply::json(json!({}))]
+        })
+        .await;
+        let media = session.resolve_media(&context(), &load()).await.unwrap();
+        assert_eq!(media.streams[0].source.as_url(), Some(source.as_str()));
+        assert_eq!(media.streams[0].content_type, expected);
+        server.await.unwrap();
+    }
+}
+
+#[tokio::test]
+async fn enforces_body_bound_when_content_length_is_missing() {
+    let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let address = listener.local_addr().unwrap();
+    let server = tokio::spawn(async move {
+        let (mut socket, _) = listener.accept().await.unwrap();
+        read_request(&mut socket).await;
+        socket
+            .write_all(b"HTTP/1.1 200 OK\r\nConnection: close\r\n\r\n")
+            .await
+            .unwrap();
+        let _ = socket.write_all(&vec![b' '; MAX_JSON_BYTES + 1]).await;
+    });
+    let session = TuneInSession {
+        tune_url: format!("http://{address}/Tune.ashx"),
+        feed_url: "unused".into(),
+        timeout: Duration::from_secs(1),
+    };
+    let error = session
+        .resolve_media(&context(), &load())
+        .await
+        .unwrap_err();
+    assert_eq!(
+        error.detail_code.as_deref(),
+        Some("TUNEIN_RESPONSE_TOO_LARGE")
+    );
+    server.await.unwrap();
+}
+
+#[tokio::test]
+async fn stalled_optional_metadata_does_not_fail_resolved_audio() {
+    let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let address = listener.local_addr().unwrap();
+    let server = tokio::spawn(async move {
+        let (mut tune_socket, _) = listener.accept().await.unwrap();
+        read_request(&mut tune_socket).await;
+        let body = serde_json::to_vec(&station("https://radio.example/live")).unwrap();
+        let header = format!(
+            "HTTP/1.1 200 OK\r\nContent-Length: {}\r\nConnection: close\r\n\r\n",
+            body.len()
+        );
+        tune_socket.write_all(header.as_bytes()).await.unwrap();
+        tune_socket.write_all(&body).await.unwrap();
+        let (_metadata_socket, _) = listener.accept().await.unwrap();
+        tokio::time::sleep(Duration::from_millis(100)).await;
+    });
+    let session = TuneInSession {
+        tune_url: format!("http://{address}/Tune.ashx"),
+        feed_url: format!("http://{address}"),
+        timeout: Duration::from_millis(25),
+    };
+    let media = session.resolve_media(&context(), &load()).await.unwrap();
+    assert_eq!(
+        media.streams[0].source.as_url(),
+        Some("https://radio.example/live")
+    );
+    assert_eq!(media.stream_type, StreamType::Live);
+    server.await.unwrap();
+}
+
+#[tokio::test]
+async fn bounds_empty_proxy_wrapper_attempts() {
+    let (session, server) = fixture(|base| {
+        let streams: Vec<Value> = (0..MAX_STREAMS)
+            .map(|index| {
+                json!({
+                    "element":"audio","url":format!("{base}/wrapper-{index}"),"is_proxy":true,
+                })
+            })
+            .collect();
+        let mut replies = vec![Reply::json(json!({"head":{"status":200},"body":streams}))];
+        replies.extend((0..MAX_WRAPPER_REQUESTS).map(|_| Reply::json(json!({"Streams":[]}))));
+        replies
+    })
+    .await;
+    let error = session
+        .resolve_media(&context(), &load())
+        .await
+        .unwrap_err();
+    assert_eq!(
+        error.detail_code.as_deref(),
+        Some("TOO_MANY_TUNEIN_WRAPPERS")
+    );
+    assert_eq!(server.await.unwrap().len(), 1 + MAX_WRAPPER_REQUESTS);
+}
diff --git a/crates/vibecast-apps-youtube/src/volume.rs b/crates/vibecast-apps-youtube/src/volume.rs
