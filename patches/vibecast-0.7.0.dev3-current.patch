+        next_json(&mut h.client).await;
+        next_json(&mut h.client).await;
+        h.hub
+            .send_player_report(report(PlayerState::Playing, None))
+            .await
+            .unwrap();
+        assert_eq!(
+            next_json(&mut h.client).await["status"][0]["playerState"],
+            "PLAYING"
+        );
+        h.hub.shutdown().await;
+    }
