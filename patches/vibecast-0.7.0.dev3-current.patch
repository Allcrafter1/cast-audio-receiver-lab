+            ns::RECEIVER,
+            "receiver-0",
+            r#"{"type":"GET_STATUS","requestId":7013}"#,
+        )
+        .await;
+        let status = next_json_for_request(client, 7013).await;
+        assert_eq!(
+            status["status"]["applications"].as_array().unwrap().len(),
