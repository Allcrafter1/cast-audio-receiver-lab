+        assert_eq!(status["status"]["applications"][0]["transportId"], first);
+        assert_eq!(status["status"]["volume"]["level"], 0.37);
+        assert_eq!(status["status"]["volume"]["muted"], true);
+    }
+    let second = launch_for_continuity(&mut video, "sender-1", "CC1AD845", 7020).await;
+    assert_ne!(first, second);
