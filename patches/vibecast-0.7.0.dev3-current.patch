+        (&vec!["2001:db8::1", "2001:db8::2"][..]).as_ip_addrs(),
+        Ok({
+            let mut set = HashSet::new();
+            set.insert(Ipv6Addr::new(0x2001, 0xdb8, 0, 0, 0, 0, 0, 1).into());
+            set.insert(Ipv6Addr::new(0x2001, 0xdb8, 0, 0, 0, 0, 0, 2).into());
