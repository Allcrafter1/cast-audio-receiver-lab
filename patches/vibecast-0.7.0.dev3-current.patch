+    #[test]
+    fn seek_rejects_previous_rate_window_without_erasing_failure_or_retry_budget() {
+        let hint = MediaCacheHint::default();
+        hint.set_recovery_attempts(1);
+        let cache = AudioCache::new(
+            reqwest::Client::new(),
+            "http://invalid.invalid".into(),
+            hint.clone(),
+        );
+        cache.shared.data.lock().unwrap().phase = Phase::Streaming;
+        let old = RateWindow {
+            epoch: 0,
+            started: std::time::Instant::now() - Duration::from_millis(9900),
+            bytes: 1,
+        };
+        cache.shared.data.lock().unwrap().source_slow = true;
+        cache.begin_seek();
+        assert!(!cache.needs_recovery_when_buffering());
+        assert!(!record_source_rate(
+            &cache.shared,
+            &old,
+            100.0,
+            1000,
+            Duration::from_secs(10),
+            0
+        ));
+        assert!(
+            !cache.needs_recovery_when_buffering(),
+            "an old 9.9s sample cannot reclassify the seek"
+        );
+        let fresh = RateWindow {
+            epoch: 1,
+            started: std::time::Instant::now() - Duration::from_secs(10),
+            bytes: 1,
+        };
+        assert!(!record_source_rate(
+            &cache.shared,
+            &fresh,
+            100.0,
+            1000,
+            Duration::from_secs(10),
+            0
+        ));
+        assert!(
+            cache.needs_recovery_when_buffering(),
+            "fresh starvation still reaches recovery"
+        );
+        assert_eq!(hint.recovery_attempts(), 1);
+        cache.shared.data.lock().unwrap().phase = Phase::Failed;
+        cache.begin_seek();
+        assert!(cache.has_failed());
+        assert_eq!(hint.recovery_attempts(), 1);
+    }
