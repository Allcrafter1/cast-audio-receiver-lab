@@ -0,0 +1,225 @@
+use super::*;
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use tokio::net::{TcpListener, TcpStream};
+use tokio::task::JoinHandle;
+use vibecast_sdk::{NoopSenderChannel, ReceiverContext};
+
+const AUTH: &str = "OAuth 2-000000-11111111-secretvalue";
+
+async fn read_request(socket: &mut TcpStream) -> String {
+    let mut request = Vec::new();
+    loop {
+        let mut byte = [0];
+        socket.read_exact(&mut byte).await.unwrap();
+        request.push(byte[0]);
+        if request.ends_with(b"\r\n\r\n") {
+            return String::from_utf8(request).unwrap();
+        }
+    }
+}
+
+/// Serves one JSON reply per connection and returns the raw request heads.
+async fn fixture(make: impl FnOnce(&str) -> Vec<(u16, Value)>) -> (SoundCloudSession, String, JoinHandle<Vec<String>>) {
+    let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let base = format!("http://{}", listener.local_addr().unwrap());
+    let replies = make(&base);
+    let server = tokio::spawn(async move {
+        let mut heads = Vec::new();
+        for (status, body) in replies {
+            let (mut socket, _) = listener.accept().await.unwrap();
+            heads.push(read_request(&mut socket).await);
+            let body = serde_json::to_vec(&body).unwrap();
+            let head = format!("HTTP/1.1 {status} R\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n", body.len());
+            socket.write_all(head.as_bytes()).await.unwrap();
+            socket.write_all(&body).await.unwrap();
+        }
+        heads
+    });
+    (SoundCloudSession { api_url: base.clone(), timeout: Duration::from_secs(2) }, base, server)
+}
+
+fn context() -> AppContext {
+    AppContext::new(
+        "session",
+        "transport",
+        "B143C57E",
+        reqwest::Client::new(),
+        ReceiverContext::new("Yamaha Cast", "Model", "device", Default::default()),
+        Arc::new(NoopSenderChannel),
+    )
+}
+
+fn load(urn: &str, auth: Option<&str>) -> LoadRequest {
+    let custom = match auth {
+        Some(a) => json!({"credentials": {"authorization": a}, "queue": [urn], "current_index": 0}),
+        None => json!({"queue": [urn]}),
+    };
+    serde_json::from_value(json!({
+        "requestId": 7,
+        "media": {"contentId": urn, "contentType": "audio/mpeg", "streamType": "BUFFERED", "customData": {}},
+        "customData": custom
+    }))
+    .unwrap()
+}
+
+fn track(_base: &str, transcodings: Value) -> Value {
+    json!([{
+        "urn": "soundcloud:tracks:42", "title": "Song", "duration": 185000,
+        "artwork_url": "https://i1.sndcdn.com/artworks-x-large.jpg",
+        "user": {"username": "Artist"},
+        "media": {"transcodings": transcodings}
+    }])
+}
+
+fn tc(base: &str, name: &str, protocol: &str, mime: &str) -> Value {
+    json!({"url": format!("{base}/media/soundcloud:tracks:42/x/stream/{name}"),
+           "format": {"protocol": protocol, "mime_type": mime}, "quality": "sq"})
+}
+
+#[test]
+fn advertises_the_soundcloud_cast_app() {
+    assert_eq!(SoundCloud.manifest().app_ids, &["B143C57E"]);
+}
+
+#[test]
+fn accepts_only_track_urns() {
+    assert_eq!(track_id("soundcloud:tracks:2425378014"), Some("2425378014"));
+    for bad in ["soundcloud:playlists:1", "soundcloud:tracks:", "soundcloud:tracks:12a", "https://x"] {
+        assert_eq!(track_id(bad), None, "{bad}");
+    }
+}
+
+#[tokio::test]
+async fn resolves_hls_mp3_and_keeps_authorization_on_api_only() {
+    let stream = "https://cf-hls-media.sndcdn.com/playlist/abc.m3u8?Policy=p&Signature=s";
+    let (session, _base, server) = fixture(|base| {
+        vec![
+            (200, track(base, json!([
+                tc(base, "enc", "ctr-encrypted-hls", "audio/mp4; codecs=\"mp4a.40.2\""),
+                tc(base, "hls", "hls", "audio/mpeg"),
+                tc(base, "prog", "progressive", "audio/mpeg"),
+            ]))),
+            (200, json!({"url": stream})),
+        ]
+    })
+    .await;
+    let mut request = load("soundcloud:tracks:42", Some(AUTH));
+    request.autoplay = false; // what the Android sender sends
+    let media = session.resolve_media(&context(), &request).await.unwrap();
+    assert!(media.autoplay, "SoundCloud LOAD must start playback like SoundCloud's receiver");
+    assert_eq!(media.streams[0].source.as_url(), Some(stream));
+    assert_eq!(media.streams[0].content_type, "application/x-mpegURL");
+    assert!(media.streams[0].drm.is_none());
+    assert_eq!(media.title.as_deref(), Some("Song"));
+    assert_eq!(media.metadata.as_ref().unwrap().artist.as_deref(), Some("Artist"));
+    assert_eq!(media.images[0].url, "https://i1.sndcdn.com/artworks-x-t500x500.jpg");
+    assert_eq!(media.duration, Some(185.0));
+    assert!(!serde_json::to_string(&media.custom_data).unwrap().contains("secretvalue"));
+    let heads = server.await.unwrap();
+    assert!(heads[0].starts_with("GET /tracks?ids=42&client_id="), "{}", heads[0]);
+    assert!(heads[1].contains("/stream/hls?app_id=soundcloud%3Aapplications%3A140141"), "{}", heads[1]);
+    for head in &heads {
+        assert!(head.to_ascii_lowercase().contains(&format!("authorization: {}", AUTH.to_ascii_lowercase())));
+    }
+}
+
+#[tokio::test]
+async fn falls_back_to_progressive_and_never_selects_encrypted() {
+    let (session, _base, server) = fixture(|base| {
+        vec![
+            (200, track(base, json!([
+                tc(base, "enc", "ctr-encrypted-hls", "audio/mp4"),
+                tc(base, "cbc", "cbc-encrypted-hls", "audio/mpeg"),
+                tc(base, "prog", "progressive", "audio/mpeg"),
+            ]))),
+            (200, json!({"url": "https://cf-media.sndcdn.com/abc.128.mp3"})),
+        ]
+    })
+    .await;
+    let media = session.resolve_media(&context(), &load("soundcloud:tracks:42", Some(AUTH))).await.unwrap();
+    assert_eq!(media.streams[0].content_type, "audio/mpeg");
+    assert!(server.await.unwrap()[1].contains("/stream/prog?"));
+}
+
+#[tokio::test]
+async fn encrypted_only_tracks_are_reported_unavailable() {
+    let (session, _base, _server) = fixture(|base| {
+        vec![(200, track(base, json!([tc(base, "enc", "ctr-encrypted-hls", "audio/mp4")])))]
+    })
+    .await;
+    let err = session.resolve_media(&context(), &load("soundcloud:tracks:42", Some(AUTH))).await.unwrap_err();
+    assert_eq!(err.detail_code.as_deref().unwrap_or(""), "SOUNDCLOUD_NO_UNENCRYPTED_STREAM");
+}
+
+#[tokio::test]
+async fn rejects_missing_auth_and_foreign_transcoding_hosts() {
+    let (session, _base, _server) = fixture(|_| vec![]).await;
+    let err = session.resolve_media(&context(), &load("soundcloud:tracks:42", None)).await.unwrap_err();
+    assert_eq!(err.detail_code.as_deref().unwrap_or(""), "SOUNDCLOUD_AUTH_MISSING");
+
+    let (session, _base, _server) = fixture(|_| {
+        vec![(200, json!([{ "urn": "soundcloud:tracks:42", "user": {},
+            "media": {"transcodings": [{"url": "https://evil.example/stream", "format": {"protocol": "hls", "mime_type": "audio/mpeg"}}]}}]))]
+    })
+    .await;
+    let err = session.resolve_media(&context(), &load("soundcloud:tracks:42", Some(AUTH))).await.unwrap_err();
+    assert_eq!(err.detail_code.as_deref().unwrap_or(""), "SOUNDCLOUD_UNEXPECTED_TRANSCODING_HOST");
+}
+
+#[tokio::test]
+async fn maps_api_http_errors() {
+    let (session, _base, _server) = fixture(|_| vec![(401, json!({"error": "unauthorized"}))]).await;
+    let err = session.resolve_media(&context(), &load("soundcloud:tracks:42", Some(AUTH))).await.unwrap_err();
+    assert_eq!(err.detail_code.as_deref().unwrap_or(""), "SOUNDCLOUD_HTTP_401_TRACKS");
+}
+
+#[tokio::test]
+async fn skips_retired_mpegurl_variant_and_uses_unencrypted_aac_hls() {
+    let aac = "https://playback.media-streaming.soundcloud.cloud/x/aac_160k/playlist.m3u8?Signature=s";
+    let (session, _base, server) = fixture(|base| {
+        vec![
+            (200, track(base, json!([
