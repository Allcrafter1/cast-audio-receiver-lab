+            (404, json!({})),
+            (404, json!({})),
+        ]
+    })
+    .await;
+    let err = session.resolve_media(&context(), &load("soundcloud:tracks:42", Some(AUTH))).await.unwrap_err();
+    assert_eq!(err.detail_code.as_deref(), Some("SOUNDCLOUD_HTTP_404_STREAM"));
+    let heads = server.await.unwrap();
+    assert!(heads[1].contains("/stream/prog?") && heads[2].contains("/stream/abr?"), "{heads:?}");
+}
