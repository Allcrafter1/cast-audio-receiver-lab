+                tc(base, "enc", "ctr-encrypted-hls", "audio/mp4; codecs=\"mp4a.40.2\""),
+                tc(base, "aac", "hls", "audio/mp4; codecs=\"mp4a.40.2\""),
+            ]))),
+            (200, json!({"url": aac})),
+        ]
+    })
+    .await;
+    let media = session.resolve_media(&context(), &load("soundcloud:tracks:42", Some(AUTH))).await.unwrap();
