@@ -0,0 +1,295 @@
+//! SoundCloud's Cast LOAD protocol (receiver app `B143C57E`).
+//!
+//! The Android sender loads `soundcloud:tracks:<id>` and passes the listener's
+//! own API authorization in top-level `customData.credentials.authorization`.
+//! The track is resolved through SoundCloud's api-v2 exactly as SoundCloud's
+//! web receiver does it. Only unencrypted transcodings are used: encrypted
+//! (Widevine/CENC/CBC) variants are skipped and never decrypted. The
+//! authorization is sent to api-v2 only, never to media hosts.
+
+#![forbid(unsafe_code)]
+
+use std::sync::Arc;
+use std::time::Duration;
+
+use async_trait::async_trait;
+use serde_json::{json, Value};
+use url::Url;
+use vibecast_sdk::{
+    AppContext, AppManifest, AppProvider, AppSession, LaunchCredentials, LaunchError, LoadRequest,
+    MediaImage, MediaMetadata, MediaResolveCode, MediaResolveError, PlaybackMedia, PlaybackStream,
+    StreamSource, StreamType,
+};
+
+const API_URL: &str = "https://api-v2.soundcloud.com";
+// Public client id and app id of SoundCloud's own Cast web receiver (cast-new.soundcloud.com).
+const CLIENT_ID: &str = "6721db99c15d087ffd251162ac08fca6";
+const APP_ID: &str = "soundcloud:applications:140141";
+const API_TIMEOUT: Duration = Duration::from_secs(8);
+const MAX_JSON_BYTES: usize = 2 * 1024 * 1024;
+
+/// SoundCloud application.
+#[derive(Debug, Default)]
+pub struct SoundCloud;
+
+#[async_trait]
+impl AppProvider for SoundCloud {
+    fn manifest(&self) -> AppManifest {
+        AppManifest::without_settings("soundcloud", &["B143C57E"], "SoundCloud")
+    }
+
+    async fn launch(
+        &self,
+        _ctx: &AppContext,
+        _credentials: LaunchCredentials,
+    ) -> Result<Arc<dyn AppSession>, LaunchError> {
+        Ok(Arc::new(SoundCloudSession {
+            api_url: API_URL.into(),
+            timeout: API_TIMEOUT,
+        }))
+    }
+}
+
+struct SoundCloudSession {
+    api_url: String,
+    timeout: Duration,
+}
+
+/// `soundcloud:tracks:<digits>` -> `<digits>`.
+fn track_id(urn: &str) -> Option<&str> {
+    let id = urn.strip_prefix("soundcloud:tracks:")?;
+    (!id.is_empty() && id.len() <= 20 && id.bytes().all(|c| c.is_ascii_digit())).then_some(id)
+}
+
+fn authorization(request: &LoadRequest) -> Result<String, MediaResolveError> {
+    let auth = request
+        .custom_data
+        .as_ref()
+        .and_then(|v| v.pointer("/credentials/authorization"))
+        .and_then(Value::as_str)
+        .unwrap_or("");
+    if auth.is_empty() {
+        return Err(MediaResolveError::invalid_request("SOUNDCLOUD_AUTH_MISSING"));
+    }
+    if auth.len() > 4096 || auth.bytes().any(|c| c.is_ascii_control()) {
+        return Err(MediaResolveError::invalid_request("SOUNDCLOUD_AUTH_INVALID"));
+    }
+    Ok(auth.to_owned())
+}
+
+/// Encrypted SoundCloud protocols need a DRM license; they are never selected.
+fn encrypted(protocol: &str) -> bool {
+    protocol.contains("encrypted") || protocol.contains("cenc")
+}
+
+/// Unencrypted transcodings in preference order: HLS MP3, HLS AAC (sq before
+/// lq), progressive MP3, then the adaptive `audio/mpegurl` playlist, which
+/// api-v2 currently answers with 404. Encrypted protocols are never returned.
+fn candidates(transcodings: &[Value]) -> Vec<(&str, &'static str)> {
+    let fmt = |t: &Value, key: &str| {
+        t.pointer(&format!("/format/{key}"))
+            .and_then(Value::as_str)
+            .unwrap_or("")
+            .to_ascii_lowercase()
+    };
+    let rank = |t: &Value| -> Option<(u8, &'static str)> {
+        let (protocol, mime) = (fmt(t, "protocol"), fmt(t, "mime_type"));
+        let lq = t.get("quality").and_then(Value::as_str) == Some("lq");
+        match (protocol.as_str(), mime.split(';').next().unwrap_or("").trim()) {
+            ("hls", "audio/mpeg") => Some((0, "application/x-mpegURL")),
+            ("hls", "audio/mp4") => Some((if lq { 2 } else { 1 }, "application/x-mpegURL")),
+            ("progressive", "audio/mpeg") => Some((3, "audio/mpeg")),
+            ("hls", "audio/mpegurl") => Some((4, "application/x-mpegURL")),
+            _ => None,
+        }
+    };
+    let mut ranked: Vec<(u8, &str, &'static str)> = transcodings
+        .iter()
+        .filter(|t| {
+            !encrypted(&fmt(t, "protocol"))
+                && !t.get("snipped").is_some_and(|v| v == true)
+                && t.get("url").and_then(Value::as_str).is_some_and(valid_url)
+        })
+        .filter_map(|t| rank(t).map(|(r, ct)| (r, t["url"].as_str().unwrap_or(""), ct)))
+        .collect();
+    ranked.sort_by_key(|(r, _, _)| *r);
+    ranked.into_iter().map(|(_, url, ct)| (url, ct)).collect()
+}
+
+fn valid_url(source: &str) -> bool {
+    !source.chars().any(char::is_control)
+        && Url::parse(source).is_ok_and(|url| {
+            matches!(url.scheme(), "http" | "https")
+                && url.host_str().is_some()
+                && url.username().is_empty()
+                && url.password().is_none()
+        })
+}
+
+fn text(value: &Value, path: &str) -> Option<String> {
+    value
+        .pointer(path)
+        .and_then(Value::as_str)
+        .filter(|v| !v.is_empty())
+        .map(str::to_owned)
+}
+
+#[async_trait]
+impl AppSession for SoundCloudSession {
+    async fn resolve_media(
+        &self,
+        ctx: &AppContext,
+        request: &LoadRequest,
+    ) -> Result<PlaybackMedia, MediaResolveError> {
+        if !request.current_time.is_finite() || request.current_time < 0.0 {
+            return Err(MediaResolveError::invalid_request("INVALID_MEDIA_TIME"));
+        }
+        let urn = request.media.content_id.as_str();
+        let id = track_id(urn)
+            .ok_or_else(|| MediaResolveError::invalid_request("UNSUPPORTED_SOUNDCLOUD_URN"))?;
+        let auth = authorization(request)?;
+        let tracks = self
+            .api_json(ctx, &format!("{}/tracks", self.api_url), &[("ids", id)], &auth, "TRACKS")
+            .await?;
+        let track = tracks
+            .as_array()
+            .and_then(|items| items.iter().find(|t| t.get("urn").and_then(Value::as_str) == Some(urn)))
+            .ok_or_else(|| MediaResolveError::content_unavailable("SOUNDCLOUD_TRACK_NOT_FOUND"))?;
+        let transcodings = track
+            .pointer("/media/transcodings")
+            .and_then(Value::as_array)
+            .map(Vec::as_slice)
+            .unwrap_or(&[]);
+        let options = candidates(transcodings);
+        if options.is_empty() {
+            return Err(MediaResolveError::content_unavailable(
+                "SOUNDCLOUD_NO_UNENCRYPTED_STREAM",
+            ));
+        }
+        let mut resolved = None;
+        let mut last_error = None;
+        for (transcoding_url, content_type) in options {
+            // The transcoding endpoint lives on api-v2; only follow it there.
+            if !transcoding_url.starts_with(&format!("{}/", self.api_url)) {
+                last_error = Some(upstream("SOUNDCLOUD_UNEXPECTED_TRANSCODING_HOST"));
+                continue;
+            }
+            match self
+                .api_json(ctx, transcoding_url, &[("app_id", APP_ID)], &auth, "STREAM")
+                .await
+            {
+                Ok(stream) => {
+                    let source = stream
+                        .get("url")
+                        .and_then(Value::as_str)
+                        .filter(|v| valid_url(v))
+                        .ok_or_else(|| upstream("SOUNDCLOUD_NO_STREAM_URL"))?;
+                    resolved = Some((source.to_owned(), content_type));
+                    break;
+                }
+                // A retired variant answers 404; the next candidate may still work.
+                Err(err) if err.detail_code.as_deref() == Some("SOUNDCLOUD_HTTP_404_STREAM") => {
+                    last_error = Some(err);
+                }
+                Err(err) => return Err(err),
+            }
+        }
+        let (source, content_type) = resolved
+            .ok_or_else(|| last_error.unwrap_or_else(|| upstream("SOUNDCLOUD_NO_STREAM_URL")))?;
+
+        let title = text(track, "/title");
+        let artist = text(track, "/user/username");
+        let artwork = text(track, "/artwork_url")
+            .or_else(|| text(track, "/user/avatar_url"))
+            .map(|v| v.replace("-large.", "-t500x500."))
+            .filter(|v| valid_url(v));
+        let mut metadata = MediaMetadata {
+            metadata_type: 3,
+            title: title.clone(),
+            artist: artist.clone(),
+            ..MediaMetadata::default()
+        };
+        if let Some(url) = artwork {
+            metadata.images = vec![MediaImage { url, height: None, width: None }];
+        }
+        let mut media = PlaybackMedia::new(
+            &ctx.session_id,
+            vec![PlaybackStream {
+                source: StreamSource::Url(source),
+                content_type: content_type.into(),
+                drm: None,
+            }],
+            StreamType::Buffered,
+        );
+        media.content_id = Some(urn.to_owned());
+        media.title = title;
+        media.subtitle = artist;
+        media.images = metadata.images.clone();
+        media.metadata = Some(metadata);
+        media.duration = track
+            .get("duration")
+            .and_then(Value::as_f64)
+            .map(|ms| ms / 1000.0);
+        // The Android app sends LOAD with autoplay=false yet shows the track as
+        // playing and never follows up with PLAY (observed 22.11.2026); SoundCloud's
+        // own receiver starts playback, so do the same. Pause stays a sender command.
+        media.autoplay = true;
+        // On a track change the Android sender keeps the previous track's position
+        // in currentTime (observed 22.11.2026: 4694 s for a 4-minute track).
+        media.start_time = match media.duration {
+            Some(total) if request.current_time >= total - 1.0 => 0.0,
+            _ => request.current_time,
+        };
+        // Echo only non-secret sender data; the authorization stays in this session.
+        media.custom_data = Some(json!({ "track": { "urn": urn } }));
+        Ok(media)
+    }
+}
+
+impl SoundCloudSession {
+    async fn api_json(
+        &self,
+        ctx: &AppContext,
+        url: &str,
+        query: &[(&str, &str)],
+        auth: &str,
+        step: &str,
+    ) -> Result<Value, MediaResolveError> {
+        let mut response = ctx
+            .http
+            .get(url)
+            .query(query)
+            .query(&[("client_id", CLIENT_ID)])
+            .header("Authorization", auth)
+            .timeout(self.timeout)
+            .send()
+            .await
+            .map_err(|_| upstream("SOUNDCLOUD_HTTP_ERROR"))?;
+        if !response.status().is_success() {
+            return Err(MediaResolveError::from_http_status(
+                response.status().as_u16(),
+                // Status and step only; response bodies and credentials stay private.
+                Some(format!("SOUNDCLOUD_HTTP_{}_{step}", response.status().as_u16())),
+            ));
+        }
+        let mut bytes = Vec::new();
+        while let Some(chunk) = response
+            .chunk()
+            .await
+            .map_err(|_| upstream("SOUNDCLOUD_HTTP_ERROR"))?
+        {
+            if chunk.len() > MAX_JSON_BYTES.saturating_sub(bytes.len()) {
+                return Err(upstream("SOUNDCLOUD_RESPONSE_TOO_LARGE"));
+            }
+            bytes.extend_from_slice(&chunk);
+        }
+        serde_json::from_slice(&bytes).map_err(|_| upstream("INVALID_SOUNDCLOUD_JSON"))
+    }
+}
+
+fn upstream(detail: &'static str) -> MediaResolveError {
+    MediaResolveError::new(MediaResolveCode::UpstreamFailure, detail)
+}
+
+#[cfg(test)]
+mod tests;
