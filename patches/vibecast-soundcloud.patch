+            (200, track(base, json!([tc(base, "hls", "hls", "audio/mpeg")]))),
+            (200, json!({"url": "https://cf-hls-media.sndcdn.com/playlist/x.m3u8"})),
+        ]
+    })
+    .await;
+    let mut request = load("soundcloud:tracks:42", Some(AUTH));
+    request.current_time = 4694.695; // previous track's position, track lasts 185 s
+    let media = session.resolve_media(&context(), &request).await.unwrap();
+    assert_eq!(media.start_time, 0.0);
+}
