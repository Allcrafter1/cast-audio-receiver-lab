+#[tokio::test]
+async fn app_state_is_isolated_between_receivers_and_retained_after_relaunch() {
+    let root = std::env::temp_dir().join(format!("vibecast-shared-state-{}", uuid::Uuid::new_v4()));
+    let catalog = SettingsCatalog::new(vec![fake_manifest().settings]).unwrap();
+    let settings = SettingsService::new(catalog, Arc::new(MemorySettingsPersistence::default()))
+        .await
+        .unwrap();
+    let mut first = setup_with_receiver_storage(
+        settings.player("first").unwrap(),
+        false,
+        PlayerCapabilities::default(),
+        "receiver-a",
+        root.clone(),
+    )
+    .await;
+    let mut second = setup_with_receiver_storage(
+        settings.player("second").unwrap(),
+        false,
+        PlayerCapabilities::default(),
+        "receiver-b",
+        root.clone(),
+    )
+    .await;
+    let transport = launch_for_continuity(&mut first.client, "sender-a", "APP1", 1601).await;
+    let first_dir = first.launched_data_dirs.lock().unwrap()[0].clone();
+    let state_name = "receiver-identity.json";
+    std::fs::write(first_dir.join(state_name), b"first receiver").unwrap();
+
+    launch_for_continuity(&mut second.client, "sender-b", "APP1", 1602).await;
+    let second_dir = second.launched_data_dirs.lock().unwrap()[0].clone();
+    assert!(
+        !second_dir.join(state_name).exists(),
+        "another receiver inherited the first receiver's persisted app identity"
+    );
+    std::fs::write(second_dir.join(state_name), b"second receiver").unwrap();
+    assert_eq!(
+        std::fs::read(first_dir.join(state_name)).unwrap(),
+        b"first receiver"
+    );
+
+    stop_for_continuity(&mut first.client, &transport, 1603).await;
+    launch_for_continuity(&mut first.client, "sender-a", "APP1", 1604).await;
+    assert_eq!(first.launched_data_dirs.lock().unwrap()[1], first_dir);
+    assert_eq!(
+        std::fs::read(first_dir.join(state_name)).unwrap(),
+        b"first receiver"
+    );
+    first.hub.shutdown().await;
+    second.hub.shutdown().await;
+    let mut restarted = setup_with_receiver_storage(
+        settings.player("first").unwrap(),
+        false,
+        PlayerCapabilities::default(),
+        "receiver-a",
+        root.clone(),
+    )
+    .await;
+    launch_for_continuity(&mut restarted.client, "sender-c", "APP1", 1605).await;
+    assert_eq!(restarted.launched_data_dirs.lock().unwrap()[0], first_dir);
+    assert_eq!(
+        std::fs::read(first_dir.join(state_name)).unwrap(),
+        b"first receiver"
+    );
+    restarted.hub.shutdown().await;
+    std::fs::remove_dir_all(root).unwrap();
 }
 
