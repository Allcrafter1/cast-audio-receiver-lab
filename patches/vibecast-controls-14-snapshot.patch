+#[tokio::test]
+async fn platform_volume_subscription_survives_app_connect() {
+    let mut harness = setup().await;
+    let client = &mut harness.client;
+    let transport = launch(client).await;
+    send(client, ns::CONNECTION, &transport, r#"{"type":"CONNECT"}"#).await;
+    // CONNECT generates no reply. Barrier through GET_STATUS drains prior work.
+    send(client, ns::RECEIVER, "receiver-0", r#"{"type":"GET_STATUS","requestId":50}"#).await;
+    loop {
+        if next_json(client).await["requestId"] == 50 { break; }
+    }
+    send(client, ns::RECEIVER, "receiver-0",
+        r#"{"type":"SET_VOLUME","requestId":51,"volume":{"level":0.42}}"#).await;
+    let reply = tokio::time::timeout(std::time::Duration::from_secs(2), async {
+        loop {
+            let reply = next_json(client).await;
+            if reply["type"] == "RECEIVER_STATUS" && reply["requestId"] == 51 { break reply; }
+        }
+    }).await.expect("platform status must arrive during an app session");
+    assert_eq!(reply["status"]["volume"]["level"], 0.42);
+    send(client, ns::MEDIA, &transport,
+        r#"{"type":"SET_VOLUME","requestId":52,"mediaSessionId":1,"volume":{"level":0.43}}"#).await;
+    let reply = tokio::time::timeout(std::time::Duration::from_secs(2), async {
+        loop {
+            let reply = next_json(client).await;
+            if reply["type"] == "RECEIVER_STATUS" { break reply; }
+        }
+    }).await.expect("media volume changes must update platform observers too");
+    assert_eq!(reply["status"]["volume"]["level"], 0.43);
+}
