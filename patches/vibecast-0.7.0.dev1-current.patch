+    assert_eq!(next_json(&mut harness.client).await["type"], "PONG");
+    assert_eq!(
+        harness.sender_attachments.lock().unwrap().as_slice(),
+        &[SenderAttachment::Initial],
+        "passive CONNECT and GET_STATUS must remain observer-only"
+    );
+
+    send(
+        &mut ipad,
+        ns::MEDIA,
