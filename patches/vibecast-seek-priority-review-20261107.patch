+#[tokio::test]
+async fn android_system_queue_probes_do_not_displace_owner_but_explicit_claim_does() {
+    let mut h = setup_exclusive().await;
+    let transport = launch(&mut h.client).await;
+    send(
+        &mut h.client,
+        ns::CONNECTION,
+        &transport,
+        r#"{"type":"CONNECT"}"#,
+    )
+    .await;
+    next_json(&mut h.client).await;
+    send(
+        &mut h.client,
+        FAKE_NS,
+        &transport,
+        r#"{"type":"PUSH_MEDIA"}"#,
+    )
+    .await;
+    next_json(&mut h.client).await;
+    next_json(&mut h.client).await;
+    let commands = h.player.commands().len();
+    let sdk = r#"{"type":"CONNECT","userAgent":"Android CastSDK,264330035,24069PC21G,peridot_eea,15","senderInfo":{"sdkType":1,"platform":1}}"#;
+    // Play services creates fresh sockets/source suffixes for background media
+    // discovery, including Assistant activation. None is explicit casting.
+    // Keep platform sockets alive to avoid unrelated disconnect-status broadcasts.
+    let mut service_sockets = Vec::new();
+    for (index, source) in [
+        "com.google.android.gms",
+        "com.google.android.gms-8",
+        "com.google.android.gms-9",
+    ]
+    .into_iter()
+    .enumerate()
+    {
+        let mut system = connect_peer(&h.hub, 10 + index as u64, "android-phone").await;
+        send_as(&mut system, source, ns::CONNECTION, "receiver-0", sdk).await;
+        send_as(&mut system, source, ns::CONNECTION, &transport, sdk).await;
+        assert_eq!(next_json(&mut system).await["type"], "MEDIA_STATUS");
+        send_as(
+            &mut system,
+            source,
+            ns::MEDIA,
+            &transport,
+            r#"{"type":"QUEUE_GET_ITEM_IDS","requestId":90}"#,
+        )
+        .await;
+        send_as(
+            &mut system,
+            source,
+            ns::MEDIA,
+            &transport,
+            r#"{"type":"GET_STATUS","requestId":91}"#,
+        )
+        .await;
+        assert_eq!(
+            next_json(&mut system).await["requestId"],
+            91,
+            "a background queue probe must not acquire ownership"
+        );
+        send(&mut h.client, FAKE_NS, &transport, r#"{"type":"PING"}"#).await;
+        assert_eq!(
+            next_json(&mut h.client).await["type"],
+            "PONG",
+            "the desktop must not receive session-ended or CLOSE"
+        );
+        assert_eq!(h.player.commands().len(), commands);
+        assert_eq!(
+            h.sender_attachments.lock().unwrap().as_slice(),
+            &[SenderAttachment::Initial]
+        );
+        if index < 2 {
+            send_as(
+                &mut system,
+                source,
+                ns::CONNECTION,
+                &transport,
+                r#"{"type":"CLOSE"}"#,
+            )
+            .await;
+            send(&mut h.client, FAKE_NS, &transport, r#"{"type":"PING"}"#).await;
+            assert_eq!(next_json(&mut h.client).await["type"], "PONG");
+        } else {
+            // A genuine app handshake on this same service socket is still
+            // a takeover: revoke desktop and notify the app to rotate Lounge.
+            send_as(
+                &mut system,
+                source,
+                FAKE_NS,
+                &transport,
+                r#"{"type":"CLAIM"}"#,
+            )
+            .await;
+            assert_eq!(next_json(&mut h.client).await["type"], "RECEIVER_STATUS");
+            assert_eq!(next_json(&mut h.client).await["type"], "CLOSE");
+            assert_eq!(next_json(&mut system).await["type"], "PONG");
+            wait_for_sender_attachments(
+                &h.sender_attachments,
+                &[SenderAttachment::Initial, SenderAttachment::Takeover],
+            )
+            .await;
+        }
+        service_sockets.push(system);
+    }
+    h.hub.shutdown().await;
+}
