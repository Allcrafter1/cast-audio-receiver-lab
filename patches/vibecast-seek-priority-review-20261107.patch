+#[tokio::test]
+async fn volume_mapping_is_sender_specific_on_ingress_and_status_feedback() {
+    for (user_agent, browser) in [
+        ("Mozilla/5.0 (X11; Linux x86_64) Chrome/130.0.0.0", true),
+        (
+            "Mozilla/5.0 (Linux; Android 15) Chrome/130.0.0.0 Mobile",
+            false,
+        ),
+        ("PyChromecast Chrome/130.0.0.0", false),
+    ] {
+        let mut h = setup().await;
+        let transport = launch(&mut h.client).await;
+        send(
+            &mut h.client,
+            ns::CONNECTION,
+            &transport,
+            &serde_json::json!({"type":"CONNECT","userAgent":user_agent}).to_string(),
+        )
+        .await;
+        next_json_of_type(&mut h.client, "MEDIA_STATUS").await;
+        send(
+            &mut h.client,
+            FAKE_NS,
+            &transport,
+            r#"{"type":"PUSH_MEDIA"}"#,
+        )
+        .await;
+        next_json_of_type(&mut h.client, "MEDIA_STATUS").await;
+        next_json_of_type(&mut h.client, "MEDIA_STATUS").await;
+        let media_id = h
+            .player
+            .commands()
+            .iter()
+            .rev()
+            .find_map(|command| match command {
+                PlayerCommand::Load { media, .. } => media.media_session_id,
+                _ => None,
+            })
+            .unwrap();
+        let mut observer = connect_peer(&h.hub, 2, "home-assistant-peer").await;
+        send_as(
+            &mut observer,
+            "sender-0",
+            ns::CONNECTION,
+            "receiver-0",
+            r#"{"type":"CONNECT","userAgent":"PyChromecast"}"#,
+        )
+        .await;
+        send_as(
+            &mut observer,
+            "sender-0",
+            ns::CONNECTION,
+            &transport,
+            r#"{"type":"CONNECT","userAgent":"PyChromecast"}"#,
+        )
+        .await;
+        next_json_of_type(&mut observer, "MEDIA_STATUS").await;
+        for (request, namespace, destination) in [
+            (91, ns::RECEIVER, "receiver-0"),
+            (92, ns::MEDIA, transport.as_str()),
+        ] {
+            send(&mut h.client, namespace, destination, &serde_json::json!({
+                "type":"SET_VOLUME", "requestId":request, "mediaSessionId":media_id, "volume":{"level":0.8,"muted":true}
+            }).to_string()).await;
+            let response = next_json_for_request(&mut h.client, request).await;
+            let level = if namespace == ns::RECEIVER {
+                &response["status"]["volume"]["level"]
+            } else {
+                &response["status"][0]["volume"]["level"]
+            };
+            assert_eq!(*level, 0.8, "sender must receive its own wire scale");
+            let expected = if browser { 0.4 } else { 0.8 };
+            // GET_STATUS acts as a barrier after broadcasts to this observer.
+            send_as(
+                &mut observer,
+                "sender-0",
+                ns::RECEIVER,
+                "receiver-0",
+                &serde_json::json!({"type":"GET_STATUS","requestId":request+100}).to_string(),
+            )
+            .await;
+            let status = next_json_for_request(&mut observer, request + 100).await;
+            assert_eq!(status["status"]["volume"]["level"], expected);
+            assert_eq!(status["status"]["volume"]["muted"], true);
+            let command = h
+                .player
+                .commands()
+                .into_iter()
+                .rev()
+                .find(|command| matches!(command, PlayerCommand::Volume { .. }))
+                .unwrap();
+            assert!(
+                matches!(command, PlayerCommand::Volume { level, muted: true, .. } if level == expected)
+            );
+            send_as(
+                &mut observer,
+                "sender-0",
+                ns::MEDIA,
+                &transport,
+                &serde_json::json!({"type":"GET_STATUS","requestId":request+200}).to_string(),
+            )
+            .await;
+            let media = next_json_for_request(&mut observer, request + 200).await;
+            assert_eq!(media["status"][0]["volume"]["level"], expected);
+        }
+        h.hub.shutdown().await;
+    }
+}
