+        next_json(&mut h.client).await;
+        send(
+            &mut h.client,
+            FAKE_NS,
+            &session,
+            &serde_json::json!({"type":"PUSH_CACHE","recoveryAttempts":attempts}).to_string(),
+        )
+        .await;
+        next_json(&mut h.client).await;
+        next_json(&mut h.client).await;
+        next_json(&mut h.client).await;
+        let report = |player_state, idle_reason| PlayerReport::State {
+            media_session_id: None,
+            session_id: session.clone(),
+            player_state,
+            current_time: 55.2,
+            duration: Some(230.0),
+            idle_reason,
+            volume_revision: None,
+            volume: None,
+            muted: None,
+        };
+        // Ordinary startup buffering is not itself an error.
+        h.hub
+            .send_player_report(report(PlayerState::Buffering, None))
+            .await
+            .unwrap();
+        assert_eq!(
+            next_json(&mut h.client).await["status"][0]["playerState"],
+            "BUFFERING"
+        );
+        next_json(&mut h.client).await;
+        let proxy = h.proxy.manifests.lock().unwrap()[&session].clone();
+        let token = h
+            .player
