+//! Optional inverse of YouTube Music Web's slider curve, not an output gain law.
+
+use std::sync::Mutex;
+
+use serde_json::Value;
+use vibecast_sdk::{AppSettingsReader, SettingKey};
+
+pub(crate) const WEB_VOLUME_COMPATIBILITY: SettingKey<bool> =
+    SettingKey::new("web_volume_compatibility");
+
+pub(crate) struct WebVolumeCompatibility {
+    settings: AppSettingsReader,
+    // A retired Lounge poll must not classify a replacement controller.
+    profile: Mutex<(u64, bool)>,
+}
+
+impl WebVolumeCompatibility {
+    pub(crate) fn new(settings: AppSettingsReader) -> Self {
+        Self {
+            settings,
+            profile: Mutex::new((0, false)),
+        }
+    }
+
+    pub(crate) fn reset(&self) {
+        let mut profile = self.profile.lock().unwrap();
+        *profile = (profile.0.wrapping_add(1), false);
+    }
+
+    pub(crate) fn epoch(&self) -> u64 {
+        self.profile.lock().unwrap().0
+    }
+
+    pub(crate) fn music_web_at_epoch(&self, epoch: u64) -> bool {
+        let profile = self.profile.lock().unwrap();
+        profile.0 == epoch && profile.1
+    }
+
+    pub(crate) fn observe(&self, epoch: u64, music_web: bool) -> bool {
+        let mut profile = self.profile.lock().unwrap();
+        if profile.0 != epoch || profile.1 == music_web {
+            return false;
+        }
+        profile.1 = music_web;
+        tracing::info!(
+            music_web_controller = music_web,
+            "YouTube web volume controller profile changed"
+        );
+        true
+    }
+
+    fn active(&self, browser: bool) -> bool {
+        browser
+            && self.profile.lock().unwrap().1
+            && self
+                .settings
+                .snapshot()
+                .get(WEB_VOLUME_COMPATIBILITY)
+                .ok()
+                .flatten()
+                .unwrap_or(true)
+    }
+
+    pub(crate) fn decode_sender(&self, level: f64, browser: bool) -> f64 {
+        if !self.active(browser) || !level.is_finite() {
+            return level;
+        }
+        // Preserve exact endpoints. Do not round here: the web sender already
+        // quantizes its wire value and output precision should not add jitter.
+        if level <= 0.0 {
+            return 0.0;
+        }
+        if level >= 1.0 {
+            return 1.0;
+        }
+        // Exact inverse of the forward curve avoids drift from the website's
+        // rounded inverse coefficients during repeated status round trips.
+        (((level * 100.0 + 7.13431).log2() - 2.82823) / (0.03917 * 100.0)).clamp(0.0, 1.0)
+    }
+
+    pub(crate) fn to_sender(&self, level: f64, browser: bool) -> f64 {
+        if !self.active(browser) || !level.is_finite() {
+            return level;
+        }
+        if level <= 0.0 {
+            return 0.0;
+        }
+        if level >= 1.0 {
+            return 1.0;
+        }
+        ((2_f64.powf(0.03917 * level * 100.0 + 2.82823) - 7.13431) / 100.0).clamp(0.0, 1.0)
+    }
+}
+
+/// Lounge identifies the application, whereas Cast identifies its transport.
+/// No profile for mobile, regular YouTube, unknown or multiple controllers.
+pub(crate) fn music_web_controller(params: Option<&Value>) -> bool {
+    let Some(devices) = params
+        .and_then(|p| p.get("devices"))
+        .and_then(Value::as_str)
+        .and_then(|raw| serde_json::from_str::<Value>(raw).ok())
+    else {
+        return false;
+    };
+    let Some(devices) = devices.as_array().filter(|devices| devices.len() <= 32) else {
+        return false;
+    };
+    let mut controller = None;
+    for device in devices {
+        match device.get("type").and_then(Value::as_str) {
+            Some("LOUNGE_SCREEN") => continue,
+            Some("REMOTE_CONTROL") => {}
+            _ => return false,
+        }
+        if controller.is_some() {
+            return false;
+        }
+        controller = Some(device);
+    }
+    controller.is_some_and(|device| {
+        device.get("app").and_then(Value::as_str) == Some("youtube.m-desktop")
+            && device
+                .get("id")
+                .and_then(Value::as_str)
+                .is_some_and(|id| !id.trim().is_empty() && id.len() <= 256)
+            && device
+                .get("theme")
+                .is_none_or(|theme| theme.as_str() == Some("m"))
+    })
+}
