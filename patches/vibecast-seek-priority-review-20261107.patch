+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    fn profile() -> WebVolumeCompatibility {
+        WebVolumeCompatibility::new(crate::tests::test_settings())
+    }
+
+    fn snapshot(devices: Value) -> Value {
+        json!({"devices": devices.to_string()})
+    }
+
+    #[test]
+    fn only_one_identified_music_web_controller_is_eligible() {
+        let web = json!({"id":"web","type":"REMOTE_CONTROL",
+            "app":"youtube.m-desktop","theme":"m"});
+        assert!(music_web_controller(Some(&snapshot(json!([web])))));
+        assert!(music_web_controller(Some(&snapshot(json!([
+            {"type":"LOUNGE_SCREEN","id":"screen"}, web
+        ])))));
+        for devices in [
+            json!([]),
+            json!([{"id":"yt","type":"REMOTE_CONTROL","app":"youtube-desktop"}]),
+            json!([{"id":"phone","type":"REMOTE_CONTROL","app":"youtube.m-android"}]),
+            json!([{"id":"unknown","type":"REMOTE_CONTROL","theme":"m"}]),
+            json!([web, {"id":"phone","type":"REMOTE_CONTROL"}]),
+            json!([web, web]),
+            json!([web, {"id":"unknown"}]),
+            json!([{"id":"web","type":"REMOTE_CONTROL","app":"youtube.m-desktop","theme":"u"}]),
+            json!([{"type":"REMOTE_CONTROL","app":"youtube.m-desktop"}]),
+        ] {
+            assert!(
+                !music_web_controller(Some(&snapshot(devices.clone()))),
+                "{devices}"
+            );
+        }
+        assert!(!music_web_controller(None));
+        assert!(!music_web_controller(Some(&json!({"devices":"not json"}))));
+        assert!(!music_web_controller(Some(&snapshot(json!({})))));
+    }
+
+    #[test]
+    fn browser_gate_and_takeover_preserve_identity_without_fresh_evidence() {
+        let profile = profile();
+        assert_eq!(profile.decode_sender(0.2, true), 0.2);
+        assert_eq!(profile.to_sender(0.5, true), 0.5);
+        let old_epoch = profile.epoch();
+        assert!(profile.observe(old_epoch, true));
+        assert_eq!(profile.decode_sender(0.2, false), 0.2);
+        assert_eq!(profile.to_sender(0.5, false), 0.5);
+        assert!((profile.decode_sender(0.2, true) - 0.4937).abs() < 0.001);
+        profile.reset();
+        assert!(!profile.observe(old_epoch, true));
+        assert_eq!(profile.decode_sender(0.2, true), 0.2);
+        assert!(profile.observe(profile.epoch(), true));
+        assert!(profile.observe(profile.epoch(), false));
+        assert_eq!(profile.to_sender(0.5, true), 0.5);
+    }
+
+    #[test]
+    fn volume_projection_roundtrips_and_preserves_exact_mute_endpoints() {
+        let profile = profile();
+        profile.observe(profile.epoch(), true);
+        for level in [0.0, 1.0] {
+            assert_eq!(profile.decode_sender(level, true), level);
+            assert_eq!(profile.to_sender(level, true), level);
+        }
+        let mut last = 0.0;
+        for percent in 1..100 {
+            let canonical = percent as f64 / 100.0;
+            let wire = profile.to_sender(canonical, true);
+            assert!(wire > last);
+            last = wire;
+            assert!((profile.decode_sender(wire, true) - canonical).abs() < 0.0001);
+        }
+        assert!((profile.to_sender(0.5, true) - 0.204682).abs() < 0.00001);
+        assert!(profile.decode_sender(f64::NAN, true).is_nan());
+    }
+}
