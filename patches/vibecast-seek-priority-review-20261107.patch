+async fn volume_revisions_reject_delayed_echoes_without_discarding_playback_or_hardware_changes() {
+    for opted_in in [true, false] {
+        let catalog = SettingsCatalog::new(vec![fake_manifest().settings]).unwrap();
+        let service = SettingsService::new(catalog, Arc::new(MemorySettingsPersistence::default()))
+            .await
+            .unwrap();
+        let capabilities = PlayerCapabilities {
+            volume_revisions: opted_in,
+            ..Default::default()
+        };
+        let mut h =
+            setup_with_capabilities(service.player("volume-test").unwrap(), false, capabilities)
+                .await;
+        let transport = launch(&mut h.client).await;
+        send(
+            &mut h.client,
+            ns::CONNECTION,
+            &transport,
+            r#"{"type":"CONNECT"}"#,
+        )
+        .await;
+        next_json_of_type(&mut h.client, "MEDIA_STATUS").await;
+        send(
+            &mut h.client,
+            FAKE_NS,
+            &transport,
+            r#"{"type":"PUSH_MEDIA"}"#,
+        )
+        .await;
+        next_json_of_type(&mut h.client, "MEDIA_STATUS").await;
+        next_json_of_type(&mut h.client, "MEDIA_STATUS").await;
+        for (request, level) in [(81, 0.4), (82, 0.6)] {
+            send(
+                &mut h.client,
+                ns::RECEIVER,
+                "receiver-0",
+                &serde_json::json!({
+                    "type":"SET_VOLUME", "requestId":request, "volume":{"level":level,"muted":true}
+                })
+                .to_string(),
+            )
+            .await;
+            next_json_for_request(&mut h.client, request).await;
+        }
+        let revision = h
+            .player
+            .commands()
+            .iter()
+            .rev()
+            .find_map(|command| match command {
+                PlayerCommand::Volume {
+                    volume_revision, ..
+                } => Some(*volume_revision),
+                _ => None,
+            })
+            .unwrap();
+        assert_eq!(revision.is_some(), opted_in);
+        for (index, reported_revision) in [revision.map(|v| v - 1), None, revision.map(|v| v + 1)]
+            .into_iter()
+            .enumerate()
+        {
+            h.hub
+                .send_player_report(PlayerReport::State {
+                    session_id: transport.clone(),
+                    media_session_id: None,
+                    player_state: PlayerState::Playing,
+                    current_time: 12.0 + index as f64,
+                    duration: None,
+                    idle_reason: None,
+                    volume: Some(0.4),
+                    muted: Some(false),
+                    volume_revision: reported_revision,
+                })
+                .await
+                .unwrap();
+            let status = next_json_of_type(&mut h.client, "MEDIA_STATUS").await;
+            assert_eq!(status["status"][0]["currentTime"], 12.0 + index as f64);
+            assert_eq!(
+                status["status"][0]["volume"]["level"],
+                if opted_in { 0.6 } else { 0.4 }
+            );
+            assert_eq!(status["status"][0]["volume"]["muted"], opted_in);
+        }
+        // This can be a real physical control after the latest command, not
+        // necessarily its requested value. Its matching revision is accepted.
+        h.hub
+            .send_player_report(PlayerReport::State {
+                session_id: transport.clone(),
+                media_session_id: None,
+                player_state: PlayerState::Playing,
+                current_time: 20.0,
+                duration: None,
+                idle_reason: None,
+                volume: Some(0.25),
+                muted: Some(false),
+                volume_revision: revision,
+            })
+            .await
+            .unwrap();
+        let status = next_json_of_type(&mut h.client, "MEDIA_STATUS").await;
+        assert_eq!(status["status"][0]["volume"]["level"], 0.25);
+        assert_eq!(status["status"][0]["volume"]["muted"], false);
+        h.hub.shutdown().await;
+    }
