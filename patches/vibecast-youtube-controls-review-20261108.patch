+        let (_, cancelled_track) = requests.recv().await.unwrap();
+        tx.send(LoungeCommand::SelectAudioTrack {
+            video_id: "A".into(),
+            audio_track_id: "absent".into(),
+            current_time: 43.0,
+            autoplay: true,
+        })
+        .await
