+        wait_loads(&player, 1).await;
+        tx.send(LoungeCommand::SelectAudioTrack {
+            video_id: "A".into(),
+            audio_track_id: "es.3".into(),
+            current_time: 42.0,
+            autoplay: true,
+        })
+        .await
