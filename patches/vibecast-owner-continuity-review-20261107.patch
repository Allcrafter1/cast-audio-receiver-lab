+#[tokio::test]
+async fn owner_continuity_survives_stop_close_and_direct_relaunch_on_the_same_connection() {
+    let mut harness = setup_exclusive().await;
+    let transport = launch_for_continuity(&mut harness.client, "browser-1", "APP1", 1001).await;
+    let initial = launched_owner_key(&harness);
+    assert!(uuid::Uuid::parse_str(&initial).is_ok());
+    assert_eq!(
+        callback_owner_key(&mut harness.client, "tab-one", &transport).await,
+        initial
+    );
+    stop_for_continuity(&mut harness.client, &transport, 1002).await;
+
+    let mut observer = connect_peer(&harness.hub, 2, "ha-observer").await;
+    send_as(
+        &mut observer,
+        "home-assistant",
+        ns::CONNECTION,
+        "receiver-0",
+        r#"{"type":"CONNECT","userAgent":"PyChromecast"}"#,
+    )
+    .await;
+    send_as(
+        &mut observer,
+        "home-assistant",
+        ns::RECEIVER,
+        "receiver-0",
+        r#"{"type":"GET_STATUS","requestId":1003}"#,
+    )
+    .await;
+    next_json_for_request(&mut observer, 1003).await;
+
+    // Logical sender ids can change without changing the existing physical
+    // owner, as happens when Chrome reopens a Cast route.
+    let transport = launch_for_continuity(&mut harness.client, "browser-2", "APP1", 1004).await;
+    assert_eq!(launched_owner_key(&harness), initial);
+    assert_eq!(
+        callback_owner_key(&mut harness.client, "tab-two", &transport).await,
+        initial
+    );
+    send_as(
+        &mut harness.client,
+        "tab-two",
+        ns::CONNECTION,
+        &transport,
+        r#"{"type":"CLOSE"}"#,
+    )
+    .await;
+    send(
+        &mut harness.client,
+        ns::RECEIVER,
+        "receiver-0",
+        r#"{"type":"GET_STATUS","requestId":1005}"#,
+    )
+    .await;
+    assert!(
+        next_json_for_request(&mut harness.client, 1005).await["status"]["applications"]
+            .as_array()
+            .unwrap()
+            .is_empty()
+    );
+
+    launch_for_continuity(&mut harness.client, "browser-3", "APP1", 1006).await;
+    assert_eq!(launched_owner_key(&harness), initial);
+    let replaced = launch_for_continuity(&mut harness.client, "browser-4", "APP1", 1007).await;
+    assert_eq!(launched_owner_key(&harness), initial);
+    assert_eq!(
+        callback_owner_key(&mut harness.client, "tab-four", &replaced).await,
+        initial
+    );
+    harness.hub.shutdown().await;
+}
