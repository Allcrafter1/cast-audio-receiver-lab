+#[tokio::test]
+async fn owner_continuity_is_invalidated_by_physical_disconnect_and_fresh_hubs() {
+    let mut harness = setup_exclusive().await;
+    let transport = launch_for_continuity(&mut harness.client, "owner-a", "APP1", 1301).await;
+    let initial = launched_owner_key(&harness);
+    stop_for_continuity(&mut harness.client, &transport, 1302).await;
+    let keys = harness.launched_owner_keys.clone();
+    let mut observer = connect_peer(&harness.hub, 2, "observer").await;
+    send(
+        &mut observer,
+        ns::CONNECTION,
+        "receiver-0",
+        r#"{"type":"CONNECT"}"#,
+    )
+    .await;
+    send(
+        &mut observer,
+        ns::RECEIVER,
+        "receiver-0",
+        r#"{"type":"GET_STATUS","requestId":1303}"#,
+    )
+    .await;
+    next_json_for_request(&mut observer, 1303).await;
+    drop(harness.client);
+    // The disconnect broadcast is a barrier: the hub has retired connection1.
+    next_json_of_type(&mut observer, "RECEIVER_STATUS").await;
+    let mut reused_counter = connect_peer(&harness.hub, 1, "peer").await;
+    launch_for_continuity(&mut reused_counter, "owner-a", "APP1", 1304).await;
+    let after_close = keys.lock().unwrap().last().unwrap().clone();
+    assert_ne!(after_close, initial);
+    harness.hub.shutdown().await;
+
+    let mut fresh = setup_exclusive().await;
+    launch_for_continuity(&mut fresh.client, "owner-a", "APP1", 1305).await;
+    let after_restart = launched_owner_key(&fresh);
+    assert_ne!(after_restart, initial);
+    assert_ne!(after_restart, after_close);
+    fresh.hub.shutdown().await;
+}
+
+#[tokio::test]
+async fn owner_continuity_does_not_cross_app_switches() {
+    let mut harness = setup_exclusive().await;
+    launch_for_continuity(&mut harness.client, "owner-a", "APP1", 1401).await;
+    let first = launched_owner_key(&harness);
+    launch_for_continuity(&mut harness.client, "owner-a", "CC1AD845", 1402).await;
+    let other_app = launched_owner_key(&harness);
+    launch_for_continuity(&mut harness.client, "owner-a", "APP1", 1403).await;
+    let returning = launched_owner_key(&harness);
+    assert_ne!(first, other_app);
+    assert_ne!(first, returning);
+    assert_ne!(other_app, returning);
+    harness.hub.shutdown().await;
+}
