+#[tokio::test]
+async fn owner_continuity_rotates_before_takeover_callbacks_and_follows_the_new_owner() {
+    let mut harness = setup_exclusive().await;
+    let transport = launch_for_continuity(&mut harness.client, "owner-a", "APP1", 1201).await;
+    let a = callback_owner_key(&mut harness.client, "owner-a", &transport).await;
+    let mut other = connect_peer(&harness.hub, 2, "different-device").await;
+    send_as(
+        &mut other,
+        "owner-b",
+        ns::CONNECTION,
+        &transport,
+        r#"{"type":"CONNECT"}"#,
+    )
+    .await;
+    send_as(
+        &mut other,
+        "owner-b",
+        FAKE_NS,
+        &transport,
+        r#"{"type":"CLAIM"}"#,
+    )
+    .await;
+    next_json_of_type(&mut other, "PONG").await;
+    let b = callback_owner_key(&mut other, "owner-b", &transport).await;
+    assert_ne!(a, b);
+    assert!(harness
+        .sender_owner_keys
+        .lock()
+        .unwrap()
+        .iter()
+        .any(|(attachment, key)| *attachment == SenderAttachment::Takeover && key == &b));
+
+    stop_for_continuity(&mut other, &transport, 1202).await;
+    launch_for_continuity(&mut other, "owner-b-again", "APP1", 1203).await;
+    assert_eq!(launched_owner_key(&harness), b);
+    launch_for_continuity(&mut harness.client, "owner-a", "APP1", 1204).await;
+    let returning_a = launched_owner_key(&harness);
+    assert_ne!(returning_a, a);
+    assert_ne!(returning_a, b);
+    harness.hub.shutdown().await;
+}
