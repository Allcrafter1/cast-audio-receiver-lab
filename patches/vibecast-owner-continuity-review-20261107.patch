+#[tokio::test]
+async fn owner_continuity_keeps_only_the_latest_launcher() {
+    let mut harness = setup_exclusive().await;
+    launch_for_continuity(&mut harness.client, "owner-a", "APP1", 1101).await;
+    let first_a = launched_owner_key(&harness);
+    let mut other = connect_peer(&harness.hub, 2, "different-device").await;
+    launch_for_continuity(&mut other, "owner-b", "APP1", 1102).await;
+    let b = launched_owner_key(&harness);
+    assert_ne!(first_a, b);
+    let transport = launch_for_continuity(&mut harness.client, "owner-a", "APP1", 1103).await;
+    let returning_a = launched_owner_key(&harness);
+    assert_ne!(
+        returning_a, first_a,
+        "a previous owner must not recover its old identity"
+    );
+    assert_ne!(returning_a, b);
+    assert_eq!(
+        callback_owner_key(&mut harness.client, "owner-a", &transport).await,
+        returning_a
+    );
+    harness.hub.shutdown().await;
+}
