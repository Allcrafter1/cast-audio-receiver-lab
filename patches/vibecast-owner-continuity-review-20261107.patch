+#[tokio::test]
+async fn owner_continuity_does_not_revive_an_owner_after_a_failed_replacement() {
+    let mut harness = setup_exclusive().await;
+    let transport = launch_for_continuity(&mut harness.client, "owner-a", "APP1", 1501).await;
+    let first_a = launched_owner_key(&harness);
+    stop_for_continuity(&mut harness.client, &transport, 1502).await;
+    let mut other = connect_peer(&harness.hub, 2, "different-device").await;
+    send_as(
+        &mut other,
+        "owner-b",
+        ns::CONNECTION,
+        "receiver-0",
+        r#"{"type":"CONNECT"}"#,
+    )
+    .await;
+    harness
+        .fail_next_launch
+        .store(true, std::sync::atomic::Ordering::Relaxed);
+    send_as(
+        &mut other,
+        "owner-b",
+        ns::RECEIVER,
+        "receiver-0",
+        r#"{"type":"LAUNCH","requestId":1503,"appId":"APP1"}"#,
+    )
+    .await;
+    assert_eq!(
