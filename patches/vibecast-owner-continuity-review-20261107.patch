+
+async fn launch_for_continuity(
+    client: &mut Framed<DuplexStream, CastCodec>,
+    source: &str,
+    app_id: &str,
+    request_id: i64,
+) -> String {
+    send_as(
+        client,
+        source,
+        ns::CONNECTION,
+        "receiver-0",
+        r#"{"type":"CONNECT"}"#,
+    )
+    .await;
+    send_as(
+        client,
+        source,
+        ns::RECEIVER,
+        "receiver-0",
+        &serde_json::json!({"type":"LAUNCH","requestId":request_id,"appId":app_id}).to_string(),
+    )
+    .await;
+    let reply = next_json_for_request(client, request_id).await;
+    assert_eq!(reply["type"], "RECEIVER_STATUS");
+    reply["status"]["applications"][0]["transportId"]
+        .as_str()
+        .unwrap()
+        .to_owned()
+}
+
+async fn stop_for_continuity(
+    client: &mut Framed<DuplexStream, CastCodec>,
+    transport: &str,
+    request_id: i64,
+) {
+    send(
+        client,
+        ns::RECEIVER,
+        "receiver-0",
+        &serde_json::json!({"type":"STOP","requestId":request_id,"sessionId":transport})
+            .to_string(),
+    )
+    .await;
+    let reply = next_json_for_request(client, request_id).await;
+    assert!(reply["status"]["applications"]
+        .as_array()
+        .unwrap()
+        .is_empty());
+}
+
+fn launched_owner_key(harness: &Harness) -> String {
+    harness
+        .launched_owner_keys
+        .lock()
+        .unwrap()
+        .last()
+        .unwrap()
+        .clone()
+}
+
+async fn callback_owner_key(
+    client: &mut Framed<DuplexStream, CastCodec>,
+    source: &str,
+    transport: &str,
+) -> String {
+    send_as(
+        client,
+        source,
+        ns::CONNECTION,
+        transport,
+        r#"{"type":"CONNECT"}"#,
+    )
+    .await;
+    send_as(
+        client,
+        source,
+        FAKE_NS,
+        transport,
+        r#"{"type":"OWNER_KEY"}"#,
+    )
+    .await;
+    next_json_of_type(client, "OWNER_KEY").await["key"]
+        .as_str()
+        .unwrap()
+        .to_owned()
+}
