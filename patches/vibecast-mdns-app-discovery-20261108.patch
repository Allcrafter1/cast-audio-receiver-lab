+/// All browse paths identify the same service instance. Announcements and
+/// goodbyes must publish/withdraw every path together.
+fn add_service_ptrs(out: &mut DnsOutgoing, info: &ServiceInfo, fullname: &str, ttl: u32) {
+    for ptr_name in std::iter::once(info.get_type()).chain(info.get_subtypes()) {
+        out.add_answer_at_time(
+            DnsPointer::new(ptr_name, RRType::PTR, CLASS_IN, ttl, fullname.to_string()),
+            0,
+        );
+    }
+}
