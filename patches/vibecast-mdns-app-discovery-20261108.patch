+        .unwrap();
+        let service = original
+            .clone()
+            .with_subtypes([first, second, "_233637de._sub._GOOGLECAST._tcp.local."])
+            .unwrap();
+        assert_eq!(service.get_subtypes().collect::<Vec<_>>(), [first, second]);
+        assert_eq!(service.get_subtype().as_deref(), Some(first));
+        assert_eq!(service.get_fullname(), original.get_fullname());
+        assert_eq!(service.get_hostname(), original.get_hostname());
+        assert_eq!(service.get_port(), original.get_port());
