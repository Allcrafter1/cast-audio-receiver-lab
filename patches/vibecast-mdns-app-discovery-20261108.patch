+    /// Add DNS-SD subtypes for the apps this receiver actually serves.
+    ///
+    /// Cast app ids are eight hexadecimal characters. Normalize aliases and
+    /// deduplicate them so every subtype points to this same service instance.
+    #[must_use]
+    pub fn with_app_ids<I, S>(mut self, app_ids: I) -> Self
+    where
+        I: IntoIterator<Item = S>,
+        S: AsRef<str>,
+    {
+        self.app_subtypes = app_ids
+            .into_iter()
+            .filter_map(|id| {
+                let id = id.as_ref();
+                (id.len() == 8 && id.bytes().all(|byte| byte.is_ascii_hexdigit()))
+                    .then(|| format!("_{}._sub.{SERVICE_TYPE}", id.to_ascii_uppercase()))
+            })
+            .collect::<std::collections::BTreeSet<_>>()
+            .into_iter()
+            .collect();
+        self
+    }
+
+    /// Full DNS-SD subtype names for app-filtered discovery.
