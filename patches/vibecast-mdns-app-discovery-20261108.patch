+#[derive(Eq, PartialEq, Debug, Clone)]
+pub struct DnsEntry {
+    pub(crate) name: String, // always lower case.
+    pub(crate) ty: RRType,
+    class: u16,
+    cache_flush: bool,
+}
+
+impl DnsEntry {
+    const fn new(name: String, ty: RRType, class: u16) -> Self {
+        Self {
+            name,
+            ty,
+            class: class & CLASS_MASK,
+            cache_flush: (class & CLASS_CACHE_FLUSH) != 0,
+        }
+    }
+}
